---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import StatusPanel from '@/components/StatusPanel.astro';
import SectionHead from '@/components/SectionHead.astro';
import PointList from '@/components/PointList.astro';
import FigureBand from '@/components/solutions/FigureBand.astro';
import CtaBlank from '@/components/CtaBlank.astro';
import StatuteMap from '@/components/solutions/StatuteMap.astro';
import { panels } from '@/data/solutions-panels';

const p = panels['ma-advisors'];
---
<Base
  title="Privaini for M&A Advisors"
  description="Outside-in privacy and AI risk assessment for target companies: assess any target from its domain, no cooperation required."
>
  <PageHero
    title="Privacy liability appears after close."
    lead="It doesn’t appear in the data room. Outside-in privacy and AI risk assessment for target companies, with no cooperation required: assess any target from its domain alone."
    secondary={{ label: 'Run diligence', href: '/request-a-demo' }}
  >
    <StatusPanel title={p.title} subject={p.subject} rows={p.rows} total={p.total} />
  </PageHero>

  <section class="section" aria-labelledby="transfer-h">
    <div class="wrap">
      <SectionHead
        id="transfer-h"
        title="Privacy liability transfers to the buyer."
        text="What was observable pre-close and wasn’t assessed becomes the acquirer’s problem."
      />
      <PointList
        variant="index"
        items={[
          { title: 'Litigation', text: 'Class-action exposure the acquirer inherits: what a suit would seek, modeled from precedent.' },
          { title: 'Regulatory', text: 'Consent decrees travel with the entity. Cross-border penalties follow the data.' },
          { title: 'Jurisdictional', text: 'Multi-jurisdiction penalties if the target operates globally without coverage.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--raised" aria-labelledby="sheet-h">
    <div class="wrap">
      <SectionHead
        id="sheet-h"
        title="Observable before the term sheet."
        text="Assess any target from the outside, no cooperation from the company required."
      />
      <FigureBand
        items={[
          { figure: '$7B+', count: 7, prefix: '$', suffix: 'B+', label: 'in global privacy fines and settlements since 2020', href: '/privacy-risk-gap', linkLabel: 'Enforcement' },
          { figure: '78%', count: 78, suffix: '%', label: 'privacy litigation surge, 2020–2024', href: '/privacy-risk-gap', linkLabel: 'Court records' },
          { figure: '$11.5M', count: 11.5, decimals: 1, prefix: '$', suffix: 'M', label: 'average BIPA & VPPA settlement', href: '/privacy-risk-gap', linkLabel: 'Settlements' },
          { figure: '€20M', count: 20, prefix: '€', suffix: 'M', label: 'GDPR max fine, or 4% of global revenue', href: '/gdpr', linkLabel: 'See GDPR' },
        ]}
      />
    </div>
  </section>

  <StatuteMap
    id="laws-h"
    flip
    heading="Assess before you sign."
    text="The exposure is observable before the deal."
    subject={p.subject}
    footnote="Assess any target across all applicable regulations, before you sign."
    items={[
      { law: 'GDPR', penalty: '€20M or 4% of global revenue', text: 'EU-target exposure before close. Art. 3 extraterritorial reach.', href: '/gdpr' },
      { law: 'CCPA / CPRA', penalty: '$7,500 per intentional violation', text: 'California data practices assessed pre-LOI. Consent flows, opt-outs.', href: '/ccpa-cpra' },
      { law: 'BIPA', penalty: '$5,000 / violation strict liability', text: 'Post-close strict liability for any biometric data the target collects.', href: '/bipa' },
      { law: 'State Privacy Laws', penalty: '20+ active state statutes', text: 'Multi-state exposure maps to where the target’s data subjects are.', href: '/state-privacy-laws', linkLabel: 'See state privacy laws' },
    ]}
  />

  <CtaBlank />
</Base>
