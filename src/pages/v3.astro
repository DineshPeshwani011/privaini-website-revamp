---
// /v3: the home page in Folio, Privaini's editorial language (docs/DESIGN-LANGUAGE.md), modelled on the
// structure of acres-yards: chapters that alternate night and stone, Urbanist headlines with a light italic accent
// line, square buttons, and scroll scenes (src/scripts/folio-home.ts). Every corner is square; the lens is the
// only round thing. Every fact is the current site's own. Kept out of search results while it is a candidate.
import '@fontsource-variable/urbanist/wght-italic.css';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/folio/Hero.astro';
import Xray from '@/components/folio/Xray.astro';
import Lines from '@/components/folio/Lines.astro';
import { sampleFindings, sampleReport, enforcement } from '@/data/findings';
import { solutions, contact } from '@/data/site';
import { customerLogos } from '@/data/logos';
import land from '@/data/globe-land.json';

// what a domain emits, as evidence plates: the code a regulator would find, and the law it meets
const plates = [
  { name: 'Meta pixel', law: 'VPPA §2710', where: 'video page', code: "fbq('track', 'ViewContent',\n  { content_ids: ['video_1142'] });", note: 'Pixels that share page and video events with ad platforms. $2,500 per violation under the Video Privacy Protection Act.', href: '/vppa' },
  { name: 'Session replay', law: 'CIPA §631', where: 'checkout', code: 'rrweb.record({\n  emit: (e) => send(e)\n});  // every key, every click', note: 'California wiretapping claims over pixels, chat and session replay.', href: '/wiretapping-cipa' },
  { name: 'Cookies', law: 'GDPR Art.7', where: 'home page', code: 'Set-Cookie: _ga=GA1.2.18494…;\n  Max-Age=63072000\n// before any consent', note: 'Set before consent, or after a rejection.', href: '/gdpr' },
  { name: 'Face scan', law: 'BIPA', where: 'virtual try-on', code: 'faceapi.detectSingleFace(video)\n  .withFaceLandmarks();', note: 'Illinois biometrics: $5,000 per violation, strict liability.', href: '/bipa' },
  { name: 'Device fingerprint', law: 'CCPA §1798', where: 'every page', code: "const fp = canvas.toDataURL();\n// fp:7c1e9a… no cookie needed", note: 'Identifiers built without a cookie.', href: '/ccpa-cpra' },
  { name: 'Consent banner', law: 'GDPR · dark patterns', where: 'cookie banner', code: '<input type="checkbox" checked>\n  Accept marketing', note: 'Consent flows designed to steer the choice.', href: '/gdpr' },
  { name: 'AI assistant', law: 'EU AI Act', where: 'support chat', code: 'model: "gpt-4o"\ndisclosure: none\nassessment: none', note: 'Automated decisioning without disclosure or assessment.', href: '/what-we-find' },
  { name: 'Privacy policy', law: 'Policy gap', where: '/privacy', code: '"We do not sell or share\n your personal information."\n// observed: 14 ad partners', note: 'What the policy says, against what the site does.', href: '/privacy-risk-gap' },
].map((p, i) => ({ ...p, n: String(i + 1).padStart(2, '0') }));

// the sample report's findings, then its remediation plan
const evidence: Record<string, string[]> = {
  VPPA: ['09:27:41  video_play  /stories/knee-surgery', '09:27:41  → facebook.com/tr  ev=ViewContent', '09:27:41  consent  none recorded'],
  CCPA: ['09:28:02  page  /conditions/diabetes', '09:28:02  → connect.facebook.net  fbevents.js', '09:28:02  notice at collection  absent'],
  BIPA: ['09:29:15  getUserMedia({ video: true })', '09:29:16  face landmarks  68 points', '09:29:16  written notice  absent'],
  GDPR: ['09:30:40  visitor  Berlin, DE', '09:30:41  POST  analytics vendor  (us-east-1)', '09:30:41  transfer mechanism  none found'],
};
const perViolation: Record<string, string> = { VPPA: '$2,500', CCPA: '$7,500 intentional', BIPA: '$5,000', GDPR: 'Up to 4% of revenue' };
const observed: Record<string, string> = {
  VPPA: 'A tracking pixel on patient-facing video pages fires on video engagement, before any consent.',
  CCPA: 'A third-party pixel loads on health condition pages, with no notice at collection.',
  BIPA: 'A virtual try-on maps the visitor’s face before any written notice or consent.',
  GDPR: 'EU visitors’ data is sent to a US analytics region with no transfer mechanism in place.',
};
const findings = sampleFindings.map((f) => ({ ...f, log: evidence[f.law], per: perViolation[f.law], said: observed[f.law] }));
const phases = [
  { name: 'Phase 1', when: 'Weeks 1–2', step: 'Hold the video pixel until consent.' },
  { name: 'Phase 2', when: 'Weeks 3–5', step: 'Remove the health-page pixel; add notice before biometric capture.' },
  { name: 'Phase 3', when: 'Weeks 6–9', step: 'Put a lawful transfer mechanism in place for EU data.' },
];
const statutes = ['VPPA', 'BIPA', 'CIPA', 'CCPA / CPRA', 'GDPR', 'COPPA', 'EU AI Act', 'UK GDPR', 'LGPD', 'State privacy laws'];

// the statute map, a dot map of the land drawn flat, with the jurisdictions the site covers
const MAP = { w: 1000, top: 80, bottom: -58 };
const MAP_H = (MAP.w * (MAP.top - MAP.bottom)) / 360;
const at = (lat: number, lon: number) => [((lon + 180) / 360) * MAP.w, ((MAP.top - lat) / (MAP.top - MAP.bottom)) * MAP_H];
const dots = (land as number[][])
  .filter(([lat]) => lat <= MAP.top && lat >= MAP.bottom)
  .map(([lat, lon]) => { const [x, y] = at(lat, lon); return `M${x.toFixed(1)} ${y.toFixed(1)}h0`; })
  .join('');
const places = [
  { key: 'ca', name: 'California', short: 'CCPA', law: 'CCPA / CPRA · CIPA', lat: 36.8, lon: -119.4, href: '/ccpa-cpra', text: '$7,500 per intentional violation under the CCPA, and wiretapping claims under CIPA over pixels, chat and session replay.' },
  { key: 'il', name: 'Illinois', short: 'BIPA', law: 'BIPA', lat: 40.0, lon: -89.2, href: '/bipa', text: '$5,000 per violation, with strict liability, for face, voice or fingerprint data taken without written notice.' },
  { key: 'us', name: 'United States', short: 'VPPA', law: 'VPPA · COPPA', lat: 38.9, lon: -77.0, href: '/vppa', text: '$2,500 per violation when video viewing data reaches a third party, and COPPA for children’s data.' },
  { key: 'co', name: 'Colorado · Virginia · Texas', short: 'state privacy laws', law: 'State privacy laws', lat: 39.0, lon: -105.5, href: '/state-privacy-laws', text: 'Twenty US states now have privacy statutes of their own: opt-outs, sensitive data and consent.' },
  { key: 'eu', name: 'European Union', short: 'GDPR', law: 'GDPR · ePrivacy · EU AI Act', lat: 50.85, lon: 4.35, href: '/gdpr', text: 'Up to €20M or 4% of revenue under the GDPR, consent rules for cookies, and new duties for AI systems.' },
  { key: 'uk', name: 'United Kingdom', short: 'UK GDPR', law: 'UK GDPR · ICO', lat: 53.5, lon: -2.2, href: '/gdpr', text: 'The UK GDPR, enforced by the Information Commissioner’s Office.' },
  { key: 'br', name: 'Brazil', short: 'LGPD', law: 'LGPD', lat: -15.8, lon: -47.9, href: '/what-we-find', text: 'Brazil’s general data protection law, modelled on the GDPR.' },
].map((p) => { const [x, y] = at(p.lat, p.lon); return { ...p, x, y }; });
const first = places[0];

// how it works
const steps = [
  { title: 'Read what your domain emits', text: 'Consent flows, tracker behaviour and policy–practice gaps across every public property you run, observed from outside.' },
  { title: 'Score it against the statutes', text: '100+ signals scored against the statutes of 90 countries and 20 US states, with reproducible, timestamped evidence.' },
  { title: 'Fix what matters first', text: 'Regulator-grade findings with a defensible exposure range, and a remediation plan staged by what matters most.' },
];

// contact: who is writing
const roles = ['An enterprise', 'An insurer', 'A broker', 'A law firm', 'An M&A advisor', 'A risk advisor'];

const [, claims, thirdParty, settlement] = enforcement;
---
<Base
  title="Privaini | Privacy & AI Risk Intelligence Platform"
  description="See privacy and AI risk the way regulators and litigators do, outside-in, from your domain alone. Continuous monitoring across 90 countries and 20 US states."
  bodyClass="home"
  folio
  noindex
>
  <div data-folio>
    <!-- hero: an ordinary website with the Privaini lens touring it; scroll draws the lens to the middle and opens it -->
    <Hero />

    <!-- what you emit -->
    <section class="emit is-stone f-section" aria-labelledby="emit-h">
      <div class="wrap">
        <div class="f-head" data-reveal-group>
          <h2 id="emit-h" class="f-h2" data-split>Everything you publish<br /><em>is evidence.</em></h2>
          <p class="f-lead" data-reveal>Eight signals from a typical company domain, as a regulator would find them. Tap one to see the law it meets.</p>
        </div>
        <ul class="plates" role="list">
          {plates.map((p) => (
            <li data-reveal>
              <button type="button" class="plate" data-plate data-n={p.n} data-name={p.name} data-law={p.law} data-where={p.where} data-code={p.code} data-note={p.note} data-href={p.href} aria-label={`${p.name}, ${p.law}: read more`}>
                <span class="plate-face is-night">
                  <span class="plate-where">{p.where} · {sampleReport.domain}</span>
                  <code>{p.code}</code>
                  <span class="plate-law">{p.law}</span>
                </span>
                <span class="plate-cap"><span class="n">{p.n}</span><span class="name">{p.name}</span><span class="law f-em">{p.law}</span></span>
              </button>
            </li>
          ))}
        </ul>
        <p class="f-caption plates-note">Code is illustrative, from Privaini’s sample report for {sampleReport.domain}.</p>
      </div>
    </section>

    <dialog class="plate-dialog" data-plate-dialog aria-labelledby="plate-d-name">
      <div class="pd is-night">
        <button type="button" class="pd-close" onclick="this.closest('dialog').close()" aria-label="Close">×</button>
        <p class="f-caption"><span data-d-n></span> · <span data-d-where></span></p>
        <h3 id="plate-d-name" class="f-title" data-d-name></h3>
        <p class="f-em pd-law" data-d-law></p>
        <pre><code data-d-code></code></pre>
        <p class="f-lead" data-d-note></p>
        <a class="f-link" href="/what-we-find" data-d-link>Read about the statute <span aria-hidden="true">→</span></a>
      </div>
    </dialog>

    <!-- the findings, travelling sideways -->
    <section class="find is-night has-lines" id="findings" data-nav-dark aria-labelledby="find-h">
      <div class="slant" aria-hidden="true"></div>
      <div class="wrap f-section find-head">
        <div class="f-head f-head--split" data-reveal-group>
          <h2 id="find-h" class="f-h2" data-split>Fewer alerts.<br /><em>Better ones.</em></h2>
          <p class="f-lead" data-reveal>Every finding names the statute it triggers, the evidence behind it and a defensible exposure range. Scroll through the sample report.</p>
        </div>
      </div>
      <div class="rail" data-rail>
        <ol class="track" data-track role="list">
          {findings.map((f, i) => (
            <li class="card">
              <div class="card-media is-night">
                <p class="cm-head"><span>{f.id || f.law}</span><span>{sampleReport.domain}</span></p>
                <p class="cm-law">{f.statute}</p>
                <ol class="cm-log" role="list">{f.log.map((l) => <li>{l}</li>)}</ol>
                <p class="cm-sev"><span class:list={['sev', `sev--${f.severity}`]}>{f.severity === 'high' ? 'High' : 'Medium'}</span><span>{f.exposure}</span></p>
              </div>
              <div class="card-body">
                <p class="f-em cb-eyebrow">{f.law} · finding {String(i + 1).padStart(2, '0')}</p>
                <h3 class="f-title">{f.title}</h3>
                <p class="f-lead">{f.said}</p>
                <dl class="specs">
                  <div><dt>Statute</dt><dd>{f.statute}</dd></div>
                  <div><dt>Severity</dt><dd>{f.severity === 'high' ? 'High' : 'Medium'}</dd></div>
                  <div><dt>Per violation</dt><dd>{f.per}</dd></div>
                  <div><dt>Exposure</dt><dd>{f.exposure}</dd></div>
                </dl>
                <a class="f-link" href="#brief">Ask about this finding <span aria-hidden="true">→</span></a>
              </div>
            </li>
          ))}
          <li class="card">
            <div class="card-media is-night plan">
              <p class="cm-head"><span>Remediation plan</span><span>{sampleReport.domain}</span></p>
              <ol class="cm-plan" role="list">
                {phases.map((p) => <li><span class="ph">{p.name}</span><span class="when">{p.when}</span><span class="what">{p.step}</span></li>)}
              </ol>
            </div>
            <div class="card-body">
              <p class="f-em cb-eyebrow">The plan · after the findings</p>
              <h3 class="f-title">Fix what matters first</h3>
              <p class="f-lead">Each phase retires findings, and with them their exposure. The total falls phase by phase, and you can show it.</p>
              <dl class="specs">
                <div><dt>Total exposure</dt><dd>{sampleReport.total}</dd></div>
                <div><dt>Findings</dt><dd>{sampleReport.findings}</dd></div>
                <div><dt>Jurisdictions</dt><dd>{sampleReport.jurisdictions}</dd></div>
                <div><dt>Phases</dt><dd>3, over 9 weeks</dd></div>
              </dl>
              <a class="f-link" href="#brief">Get your own plan <span aria-hidden="true">→</span></a>
            </div>
          </li>
        </ol>
        <div class="wrap rail-foot">
          <Lines kind="ruler" class="rail-lines" />
          <span class="f-caption"><span data-count-now>01</span> / {String(findings.length + 1).padStart(2, '0')}</span>
          <span class="bar" aria-hidden="true"><i data-bar></i></span>
          <span class="f-caption">Keep scrolling</span>
        </div>
      </div>
      <p class="wrap f-caption sample-note">Sample report for {sampleReport.domain}. {sampleReport.validated}</p>
    </section>

    <!-- trusted by, and the laws we read -->
    <section class="marquees is-night" data-nav-dark aria-label="Trusted by insurers, brokers and enterprises">
      <div class="wrap mq-label"><p class="f-caption">Trusted by insurers, brokers and enterprises</p></div>
      <div class="mq">
        {[0, 1].map((c) => (
          <ul role="list" class="mq-set logos" aria-hidden={c === 1 ? 'true' : undefined}>
            {customerLogos.map((l) => <li><img src={l.src} alt={c === 0 ? l.name : ''} width="160" height="116" loading="lazy" decoding="async" /></li>)}
          </ul>
        ))}
      </div>
      <div class="mq mq--rev" aria-hidden="true">
        {[0, 1].map(() => (
          <ul role="list" class="mq-set laws">{statutes.map((s) => <li class="f-em">{s}</li>)}</ul>
        ))}
      </div>
    </section>

    <!-- the scale: one figure, counted while the chapter holds -->
    <section class="scale is-night" data-scale data-nav-dark aria-labelledby="scale-h">
      <!-- the gauge, this chapter's hairline: a square of 120 ticks, and a cyan line that runs round it, from the
           top, to the figure's share as the figure counts -->
      <div class="scale-ring" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <rect class="sr-ticks" x="16" y="16" width="168" height="168" pathLength="120" />
          <rect class="sr-track" x="6" y="6" width="188" height="188" />
          <path class="sr-arc" data-scale-arc d="M100 6H194V194H6V6Z" pathLength="100" style={`stroke-dashoffset: ${100 - Number(claims.count)}`} />
        </svg>
      </div>
      <div class="wrap scale-in">
        <p class="scale-fig"><span class="scale-num"><span class="f-figure" data-figure={claims.count}>{claims.count}</span><span class="f-figure pct">%</span></span><span class="f-em scale-of">{claims.label}</span></p>
        <h2 id="scale-h" class="f-h2">Enforcement is routine.<br /><em>Exposure is visible.</em></h2>
        <p class="f-lead">Most enforcement actions hit companies that didn’t see them coming. Privaini shows you the exposure first, from your domain alone.</p>
        <dl class="scale-stats">
          {[enforcement[0], thirdParty, settlement].map((e) => (
            <div><dt class="f-title">{e.figure}</dt><dd class="f-small">{e.label}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- the statute map -->
    <section class="map is-night f-section" data-map data-nav-dark aria-labelledby="map-h">
      <div class="wrap map-grid">
        <div class="map-side" data-reveal-group>
          <h2 id="map-h" class="f-h2" data-split>Ninety countries,<br /><em>mapped.</em></h2>
          <p class="f-lead" data-reveal>The advice starts with the laws that apply to you, wherever your visitors are, not with one regulator’s checklist.</p>
          <ul class="places" role="list" data-reveal>
            {places.map((p, i) => (
              <li><button type="button" data-place={p.key} data-name={p.name} data-short={p.short} data-law={p.law} data-text={p.text} data-href={p.href} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="pl-name">{p.name}</span><span class="pl-law">{p.law}</span>
              </button></li>
            ))}
          </ul>
        </div>
        <div class="map-stage" data-reveal>
          <svg viewBox={`0 0 ${MAP.w} ${MAP_H.toFixed(0)}`} role="img" aria-label="A flat dot map of the world with Privaini's statute coverage marked: California, Illinois, the United States, US state laws, the European Union, the United Kingdom and Brazil.">
            {[60, 30, 0, -30].map((lat) => <path class="grat" d={`M0 ${at(lat, 0)[1].toFixed(1)}H${MAP.w}`} />)}
            <path class="land" d={dots} />
            {places.map((p, i) => (
              <g class:list={['pin', { on: i === 0 }]} data-pin={p.key} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
                <rect class="halo" x="-12" y="-12" width="24" height="24" /><rect class="dot" x="-4" y="-4" width="8" height="8" />
              </g>
            ))}
          </svg>
          <div class="place-card" data-place-card aria-live="polite">
            <p class="f-em" data-c-law>{first.law}</p>
            <p class="f-title pc-name" data-c-name>{first.name}</p>
            <p class="f-small" data-c-text>{first.text}</p>
            <a class="f-link" href={first.href} data-c-link><span data-c-linktext>Read about {first.short}</span> <span aria-hidden="true">→</span></a>
          </div>
          <p class="f-caption map-note">Stylised map, not to scale. Coverage: 90 countries and 20 US states.</p>
        </div>
      </div>
    </section>

    <!-- how it works, three steps while the chapter holds -->
    <section class="steps is-stone" data-steps aria-labelledby="steps-h">
      <div class="wrap steps-in">
        <div class="f-head" data-reveal-group>
          <h2 id="steps-h" class="f-h2" data-split>Fewer questionnaires.<br /><em>More evidence.</em></h2>
        </div>
        <ol class="step-list" role="list">
          {steps.map((s, i) => (
            <li class:list={['step', { on: i === 0 }]} data-step>
              <span class="f-figure step-n">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-copy"><h3 class="f-title">{s.title}</h3><p class="f-lead">{s.text}</p></div>
            </li>
          ))}
        </ol>
        <div class="ticks" aria-hidden="true">{steps.map((_, i) => <i class:list={{ on: i === 0 }} data-tick></i>)}</div>
      </div>
    </section>

    <!-- the picture opens out -->
    <section class="expand is-night" data-expand data-nav-dark aria-labelledby="expand-h">
      <div class="expand-media" data-expand-media aria-hidden="true">
        <div class="expand-xr" data-expand-xr><Xray mode="evidence" /></div>
        <div class="shade"></div>
      </div>
      <div class="wrap expand-copy" data-expand-copy>
        <h2 id="expand-h" class="f-h2">Every finding<br /><em>starts with evidence.</em></h2>
        <p class="f-lead">From your domain alone: no questionnaires, no installation, no IT lift.</p>
      </div>
    </section>

    <!-- who it is for: a timeline that draws itself as the chapter scrolls by, lighting each audience in turn -->
    <section class="who is-stone f-section" aria-labelledby="who-h">
      <div class="wrap">
        <div class="f-head f-head--split" data-reveal-group>
          <h2 id="who-h" class="f-h2" data-split>One domain.<br /><em>Every team with exposure.</em></h2>
          <p class="f-lead" data-reveal>The same outside-in reading serves everyone who carries privacy risk: the company itself, and the people who insure, place, litigate or buy it.</p>
        </div>
        <ol class="line" role="list" data-line>
          {solutions.map((s, i) => (
            <li data-line-item style={`--i: ${i}`}>
              <i class="node" aria-hidden="true"></i>
              <a href={s.href} class="who-item">
                <span class="f-title who-name">{s.label}</span>
                <span class="f-small">{s.note}</span>
                <span class="f-link who-go">Explore <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- contact -->
    <section class="brief is-night f-section has-lines" id="brief" data-nav-dark aria-labelledby="brief-h">
      <Lines kind="trace" class="brief-lines" />
      <div class="wrap br-grid">
        <div class="br-side" data-reveal-group>
          <h2 id="brief-h" class="f-h2" data-split>Let’s see<br /><em>what they see.</em></h2>
          <dl class="contacts" data-reveal>
            <div><dt class="f-caption">Sales</dt><dd><a href={`mailto:${contact.sales}`}>{contact.sales}</a><button type="button" class="copy" data-copy={contact.sales}>Copy</button></dd></div>
            <div><dt class="f-caption">Support</dt><dd><a href={`mailto:${contact.support}`}>{contact.support}</a><button type="button" class="copy" data-copy={contact.support}>Copy</button></dd></div>
            <div><dt class="f-caption">Office</dt><dd>{contact.address.join(', ')}</dd></div>
          </dl>
        </div>
        <form class="br-form" data-brief data-reveal>
          <label class="fld fld--wide"><span>Company domain</span><input name="domain" type="text" inputmode="url" autocomplete="url" placeholder="yourcompany.com" spellcheck="false" required /></label>
          <label class="fld"><span>Full name</span><input name="name" type="text" autocomplete="name" /></label>
          <label class="fld"><span>I’m with</span>
            <select name="role">{roles.map((r) => <option>{r}</option>)}</select>
          </label>
          <label class="fld fld--wide"><span>Looking for</span>
            <select name="need">
              <option>An exposure assessment of our domain</option>
              <option>Continuous monitoring</option>
              <option>Portfolio or book monitoring</option>
              <option>A partnership</option>
            </select>
          </label>
          <label class="fld fld--wide"><span>Anything we should know</span><textarea name="note" rows="3"></textarea></label>
          <div class="fld--wide br-send">
            <button type="submit" class="f-btn f-btn--cyan">Prepare my email <span aria-hidden="true">→</span></button>
            <p class="f-small">Your details go into an email you can review before sending. Nothing is stored on this site.</p>
          </div>
        </form>
      </div>
    </section>
  </div>
</Base>

<script>
  import { mountFolioHome } from '@/scripts/folio-home';
  const root = document.querySelector<HTMLElement>('[data-folio]');
  if (root) mountFolioHome(root);
</script>

<style>
  /* the hero and its styles: src/components/folio/Hero.astro */

  /* ---- evidence plates ---- */
  .emit { margin-top: -2px; position: relative; z-index: 1; }
  .plates { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(28px, 3vw, 48px) var(--gap); }
  .plates li:nth-child(4n + 2) { margin-top: 64px; }
  .plates li:nth-child(4n + 3) { margin-top: 24px; }
  .plates li:nth-child(4n + 4) { margin-top: 96px; }
  .plate { display: grid; gap: 14px; width: 100%; text-align: left; cursor: pointer; }
  .plate-face {
    position: relative; display: grid; align-content: space-between; gap: 18px; aspect-ratio: 4 / 5; padding: 20px;
    overflow: hidden; transition: transform 0.6s var(--ease-edit);
    background: radial-gradient(120% 80% at 80% 0%, #17292d, var(--night) 60%);
  }
  .plate:hover .plate-face { transform: translateY(-6px); }
  .plate-where { font: 500 12px/1.3 var(--font); letter-spacing: 0.02em; color: var(--on-night-muted); }
  .plate-face code, .pd code, .cm-log { font-variant-ligatures: none; }   /* code shows as typed: => stays =>, not an arrow */
  .plate-face code { font: 400 clamp(11.5px, 0.95vw, 13.5px)/1.65 var(--mono); color: var(--on-night); white-space: pre-wrap; }
  .plate-law { justify-self: start; font: italic 300 22px/1 var(--font); letter-spacing: -0.02em; color: var(--cyan-soft); }
  .plate-cap { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; row-gap: 2px; align-items: baseline; }
  .plate-cap .n { font: 500 12px/1 var(--font); font-variant-numeric: tabular-nums; color: var(--on-stone-muted); grid-row: span 2; }
  .plate-cap .name { font-size: 16px; font-weight: 500; color: var(--on-stone); }
  .plate-cap .law { font-size: 14px; }
  .plates-note { margin-top: 40px; }

  .plate-dialog { border: 0; padding: 0; background: transparent; max-width: min(680px, calc(100vw - 32px)); width: 100%; }
  .plate-dialog::backdrop { background: rgba(11, 15, 16, 0.72); backdrop-filter: blur(4px); }
  .pd { position: relative; display: grid; gap: 16px; padding: clamp(28px, 4vw, 48px); }
  .pd pre { margin: 6px 0; padding: 18px; background: var(--night-3); overflow-x: auto; }
  .pd code { font: 400 14px/1.7 var(--mono); color: var(--on-night); }
  .pd-law { font-size: 20px; }
  .pd-close { position: absolute; top: 14px; right: 18px; font-size: 28px; line-height: 1; color: var(--on-night-muted); }
  .pd-close:hover { color: var(--on-night); }

  /* ---- findings ---- */
  .find { position: relative; }
  .slant { position: absolute; left: 0; right: 0; top: -1px; height: clamp(40px, 7vw, 110px); background: var(--stone); clip-path: polygon(0 0, 100% 0, 0 100%); pointer-events: none; }
  .find-head { padding-bottom: clamp(40px, 5vw, 72px); }
  /* one column the width of the screen: the track overflows it rather than widening it (and its inset stays the page's) */
  .rail { height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; align-content: center; padding-block: calc(var(--nav-h) + 24px) 40px; overflow: hidden; }
  .track { min-width: 0; display: flex; gap: clamp(24px, 3vw, 48px); list-style: none; margin: 0; padding: 0 0 0 var(--inset, var(--margin)); align-items: stretch; will-change: transform; }
  .card { flex: none; width: min(1120px, 82vw); display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(28px, 3.5vw, 56px); align-items: stretch; }
  .card-media {
    display: grid; align-content: space-between; gap: 22px; padding: clamp(22px, 2.4vw, 34px);
    background: radial-gradient(100% 90% at 0% 0%, #163036, var(--night-2) 65%); border: 1px solid var(--on-night-line);
    min-height: min(60svh, 600px);
  }
  .cm-head { display: flex; justify-content: space-between; gap: 12px; font: 500 12.5px/1 var(--font); letter-spacing: 0.02em; color: var(--on-night-muted); }
  .cm-law { font: 300 clamp(56px, 7vw, 112px)/0.92 var(--font); letter-spacing: -0.06em; color: var(--on-night); }
  .cm-log { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font: 400 12.5px/1.5 var(--mono); color: var(--on-night-muted); border-top: 1px solid var(--on-night-line); padding-top: 18px; }
  .cm-log li:last-child { color: var(--cyan-soft); }
  .cm-sev { display: flex; justify-content: space-between; align-items: center; font: 500 15px/1 var(--font); color: var(--on-night); }
  .sev { padding: 6px 11px; font: 600 11px/1 var(--font); letter-spacing: 0.08em; text-transform: uppercase; }
  .sev--high { background: var(--on-night); color: var(--night); }
  .sev--med { border: 1px solid var(--on-night); }
  .cm-plan { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .cm-plan li { display: grid; grid-template-columns: 90px 1fr; column-gap: 16px; row-gap: 4px; padding: 18px 0; border-top: 1px solid var(--on-night-line); }
  .cm-plan .ph { font: italic 300 22px/1 var(--font); letter-spacing: -0.02em; color: var(--cyan-soft); grid-row: span 2; }
  .cm-plan .when { font: 500 12.5px/1.3 var(--font); color: var(--on-night-muted); }
  .cm-plan .what { font-size: 15px; color: var(--on-night); }
  .card-body { display: grid; align-content: center; gap: 22px; justify-items: start; }
  .cb-eyebrow { font-size: 18px; }
  .specs { display: grid; grid-template-columns: 1fr 1fr; width: 100%; margin: 4px 0 6px; }
  .specs div { display: grid; gap: 6px; padding: 16px 16px 16px 0; border-top: 1px solid var(--on-night-line); }
  .specs dt { font-size: 12.5px; color: var(--on-night-muted); }
  .specs dd { margin: 0; font: 400 20px/1.2 var(--font); letter-spacing: -0.02em; color: var(--on-night); }
  .rail-foot { position: relative; display: flex; align-items: center; gap: 20px; margin-top: 56px; }
  /* the ruler the findings travel along: full width, just over the counter; its ticks slide with the cards */
  .rail-foot :global(.rail-lines) { left: 50%; width: 100vw; translate: -50% 0; top: -30px; height: 14px; }
  .bar { flex: 0 0 160px; height: 1px; background: var(--on-night-line); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--on-night); transform: scaleX(0.04); transform-origin: left; }
  .sample-note { padding-bottom: clamp(64px, 8vw, 120px); }

  /* ---- trusted by / the laws ---- */
  .marquees { padding-block: 0 clamp(72px, 8vw, 120px); display: grid; gap: 20px; }
  .mq-label { margin-bottom: 8px; }
  .mq { display: flex; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .mq-set { display: flex; align-items: center; flex: none; gap: clamp(32px, 3.5vw, 64px); padding-right: clamp(32px, 3.5vw, 64px); list-style: none; margin: 0; animation: mq 70s linear infinite; }
  .mq--rev .mq-set { animation-duration: 90s; animation-direction: reverse; }
  .mq:hover .mq-set { animation-play-state: paused; }
  @keyframes mq { to { transform: translateX(-100%); } }
  .logos img { display: block; height: 80px; width: auto; filter: grayscale(1) invert(1) contrast(1.2); mix-blend-mode: screen; opacity: 0.72; }
  .laws li { font-size: clamp(28px, 3vw, 46px); white-space: nowrap; color: var(--on-night-muted); }
  .laws li::after { content: '·'; margin-left: clamp(32px, 3.5vw, 64px); font-style: normal; color: var(--on-night-line); }

  /* ---- the scale ---- */
  .scale { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  /* top right, clear of the copy, which sits at the bottom left: a square fills its corners, unlike a ring */
  .scale-ring { position: absolute; right: var(--inset); top: calc(var(--nav-h) + 4svh); width: min(56svh, 34vw); aspect-ratio: 1; }
  .scale-ring svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .scale-ring :is(rect, path) { fill: none; }
  /* the track stays a 1px hairline at any size; the ticks and the cyan line are measured along their paths
     (pathLength), so they stroke in the drawing's own units, 200 across (a scaling stroke throws the measure off) */
  .sr-track { stroke: var(--on-night-line); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .sr-ticks { stroke: var(--on-night-line); stroke-width: 2.1px; stroke-dasharray: 0.12 0.88; }
  .sr-arc { stroke: var(--cyan); stroke-width: 0.6px; stroke-dasharray: 100 100; }
  .scale-in { position: relative; display: grid; gap: 22px; padding-block: calc(var(--nav-h) + 16px) clamp(48px, 6vw, 88px); }
  /* sized so figure, headline, sentence and the three figures under it all fit one screen while it holds */
  .scale-fig { display: flex; align-items: flex-end; flex-wrap: wrap; column-gap: 24px; margin: 0; }
  .scale-num { display: flex; align-items: baseline; }
  .scale-fig .f-figure { font-size: clamp(96px, min(13vw, 22svh), 220px); }
  .scale-fig .pct { font-size: clamp(48px, min(6.5vw, 11svh), 110px); margin-left: -0.08em; }
  .scale-of { font-size: clamp(18px, 1.6vw, 24px); max-width: 22ch; padding-bottom: 0.9em; }
  .scale-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin: 16px 0 0; max-width: 980px; }
  .scale-stats div { display: grid; gap: 8px; padding-top: 18px; border-top: 1px solid var(--on-night-line); }
  .scale-stats dd { margin: 0; max-width: 28ch; }

  /* ---- the map ---- */
  .map { background: var(--night-2); }
  .map-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 4vw, 72px); align-items: center; }
  .map-side { display: grid; gap: 24px; }
  .places { list-style: none; margin: 8px 0 0; padding: 0; }
  .places button { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; width: 100%; padding: 14px 0; border-top: 1px solid var(--on-night-line); text-align: left; color: var(--on-night-muted); transition: color 0.3s; }
  .places li:last-child button { border-bottom: 1px solid var(--on-night-line); }
  .pl-name { font-size: 16px; }
  .pl-law { font-size: 12.5px; text-align: right; }
  .places button:hover, .places button[aria-pressed='true'] { color: var(--on-night); }
  .places button[aria-pressed='true'] .pl-law { color: var(--cyan-soft); }
  .map-stage { position: relative; }
  .map-stage svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grat { stroke: var(--on-night-line); stroke-width: 1; stroke-dasharray: 2 6; vector-effect: non-scaling-stroke; }
  .land { stroke: rgba(232, 236, 233, 0.32); stroke-width: 3; stroke-linecap: square; fill: none; }
  .pin { cursor: pointer; }
  .pin .dot { fill: var(--cyan-soft); }
  .pin .halo { fill: none; stroke: var(--cyan-soft); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .pin.on .dot { fill: var(--cyan); }
  .pin.on .halo { opacity: 1; animation: halo 2.4s var(--ease-edit) infinite; }
  @keyframes halo { 0% { transform: scale(0.4); opacity: 1; } 100% { transform: scale(1.9); opacity: 0; } }
  .place-card {
    position: absolute; right: 0; bottom: 6%; width: min(340px, 46%); display: grid; gap: 10px; justify-items: start;
    padding: 24px; background: rgba(11, 15, 16, 0.86); border: 1px solid var(--on-night-line); backdrop-filter: blur(6px);
  }
  .pc-name { font-size: clamp(26px, 2.2vw, 34px); }
  .map-note { margin-top: 18px; }

  /* ---- steps ---- */
  .steps { min-height: 100svh; display: grid; align-items: center; }
  .steps-in { padding-block: calc(var(--nav-h) + 40px) clamp(48px, 6vw, 88px); }
  .steps .f-head { margin-bottom: clamp(32px, 4vw, 64px); }
  .step-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .step { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--gap); align-items: center; opacity: 0; visibility: hidden; transition: opacity 0.6s var(--ease-edit), visibility 0s 0.6s; }
  .step.on { opacity: 1; visibility: visible; transition: opacity 0.6s var(--ease-edit); }
  .step-n { color: var(--teal); }
  .step.on .step-n, .step.on .step-copy { animation: rise 0.8s var(--ease-edit) both; }
  .step.on .step-copy { animation-delay: 0.06s; }
  @keyframes rise { from { transform: translateY(28px); opacity: 0; } }
  .step-copy { display: grid; gap: 18px; }
  .ticks { display: flex; gap: 10px; margin-top: 32px; }
  .ticks i { width: 36px; height: 2px; background: var(--on-stone-line); transition: background-color 0.4s; }
  .ticks i.on { background: var(--teal); }

  /* ---- expand ---- */
  .expand { position: relative; height: 100svh; overflow: hidden; display: grid; align-items: center; }
  .expand-media { position: absolute; inset: 0; clip-path: inset(16% 22% 16% 22%); will-change: clip-path; background: var(--night-2); }
  /* the whole page as the lens reads it */
  .expand-xr { position: absolute; right: max(var(--margin), 4vw); top: 50%; width: min(60vw, 116svh); translate: 0 -50%; }
  .shade { position: absolute; inset: 0; }
  .expand-media .shade { background: linear-gradient(to right, rgba(11, 15, 16, 0.95), rgba(11, 15, 16, 0.78) 30%, rgba(11, 15, 16, 0.12) 60%, transparent); }
  .expand-copy { position: relative; display: grid; gap: 24px; }
  .expand-copy h2 { max-width: 14ch; }

  /* ---- who: the timeline ---- */
  /* --p (0 to 1) draws the teal line over the grey one; folio-home.ts sets it as the chapter scrolls by and lights
     each audience (.on) as the line reaches its node. Without the script, or under reduced motion, it is all drawn. */
  .line { --p: 1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--gap); position: relative; }
  .line::before, .line::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; height: 1px; }
  .line::before { background: var(--on-stone-line); }
  .line::after { background: var(--teal); transform: scaleX(var(--p)); transform-origin: left; }
  .line li { position: relative; display: grid; gap: 22px; padding-top: 0; }
  .node { width: 13px; height: 13px; border: 1px solid var(--teal); background: var(--teal); position: relative; z-index: 1; transition: background-color 0.4s, border-color 0.4s, outline-color 0.3s; outline: 1px solid transparent; outline-offset: 3px; }
  .line li:hover .node { outline-color: var(--teal); }
  .line.is-armed li:not(.on) .node { background: var(--stone); border-color: color-mix(in srgb, var(--on-stone) 28%, transparent); }
  .line.is-armed .who-item { transition: opacity 0.7s var(--ease-edit), translate 0.9s var(--ease-edit); }
  .line.is-armed li:not(.on) .who-item { opacity: 0.2; translate: 0 18px; }
  .who-item { display: grid; gap: 12px; justify-items: start; }
  .who-name { font-size: clamp(24px, 1.9vw, 30px); }
  .who-go { font-size: 14px; margin-top: 4px; }

  /* ---- contact ---- */
  .br-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(40px, 6vw, 112px); align-items: start; }
  .br-side { display: grid; gap: 28px; }
  .contacts { display: grid; margin: 12px 0 0; }
  .contacts div { display: grid; gap: 6px; padding: 18px 0; border-top: 1px solid var(--on-night-line); }
  .contacts dd { margin: 0; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; font: 400 clamp(19px, 1.5vw, 23px)/1.3 var(--font); letter-spacing: -0.02em; }
  .contacts a:hover { color: var(--cyan-soft); }
  .copy { font: 500 12px/1 var(--font); padding: 7px 12px; border: 1px solid var(--on-night-line); color: var(--on-night-muted); }
  .copy:hover { color: var(--on-night); border-color: var(--on-night-muted); }
  .br-form { display: grid; grid-template-columns: 1fr 1fr; gap: 26px var(--gap); padding-top: 8px; }
  .fld { display: grid; gap: 10px; }
  .fld--wide { grid-column: 1 / -1; }
  .fld > span { font-size: 13px; color: var(--on-night-muted); }
  .fld input, .fld select, .fld textarea {
    width: 100%; padding: 12px 0; border: 0; border-bottom: 1px solid var(--on-night-line); background: transparent;
    font: 400 17px/1.4 var(--font); color: var(--on-night); outline: none; transition: border-color 0.3s; border-radius: 0;
  }
  .fld select { appearance: none; background: linear-gradient(45deg, transparent 50%, var(--on-night-muted) 50%) right 6px center / 6px 6px no-repeat, linear-gradient(-45deg, transparent 50%, var(--on-night-muted) 50%) right 0 center / 6px 6px no-repeat; padding-right: 24px; }
  .fld select option { color: #111; }
  .fld input:focus, .fld select:focus, .fld textarea:focus { border-bottom-color: var(--cyan-soft); }
  .fld input::placeholder { color: #5f6b6a; }
  .br-send { display: grid; gap: 14px; justify-items: start; margin-top: 8px; }
  /* the chapter's hairline: a signal along its foot, in the dark between the form and the footer */
  .brief :global(.brief-lines) { left: 0; width: 100%; bottom: clamp(36px, 4.5vw, 72px); height: 26px; }

  /* ---- narrow screens: nothing pins, everything stacks ---- */
  @media (max-width: 899px) {
    /* in one column the copy fills the width, and the gauge's straight edges would run through it */
    .scale-ring { display: none; }
    .plates { grid-template-columns: 1fr 1fr; }
    .plates li:nth-child(n) { margin-top: 0; }
    .plates li:nth-child(even) { margin-top: 36px; }
    .rail { height: auto; padding-block: 0 24px; }
    .track { flex-direction: column; padding: 0 var(--margin); gap: 56px; }
    .card { width: 100%; grid-template-columns: 1fr; }
    .card-media { min-height: 0; }
    .rail-foot { display: none; }
    .map-grid, .br-grid { grid-template-columns: 1fr; }
    .place-card { position: static; width: 100%; margin-top: 16px; }
    .steps { min-height: 0; }
    .step { grid-area: auto; opacity: 1; visibility: visible; grid-template-columns: auto 1fr; padding-block: 24px; border-top: 1px solid var(--on-stone-line); }
    .step-n { font-size: 72px; }
    .ticks { display: none; }
    .expand { height: 80svh; align-items: end; padding-bottom: 56px; }
    .expand-media { clip-path: none; }
    .expand-xr { left: var(--margin); right: var(--margin); top: calc(var(--nav-h) + 8px); width: auto; translate: none; }
    .expand-media .shade { background: linear-gradient(to top, rgba(11, 15, 16, 0.95) 30%, rgba(11, 15, 16, 0.3) 70%, transparent); }
    .scale-stats { grid-template-columns: 1fr; }
    .line { grid-template-columns: 1fr; gap: 32px; }
    .line::before, .line::after { left: 6px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .line::after { transform: scaleY(var(--p)); transform-origin: top; }
    .line li { grid-template-columns: 13px 1fr; gap: 20px; }
    .br-form { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .plates { grid-template-columns: 1fr; }
    .plates li:nth-child(even) { margin-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-set { animation: none; }
    .step { grid-area: auto; opacity: 1; visibility: visible; }
    .expand-media { clip-path: none; }
    .pin.on .halo { animation: none; opacity: 0.6; }
  }
</style>
