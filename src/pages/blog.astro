---
import Base from '@/layouts/Base.astro';
import CtaBlank from '@/components/CtaBlank.astro';
import HairlineField from '@/components/hairline/HairlineField.astro';
import { posts, categories, formatDate } from '@/data/posts';
const [lead, ...rest] = posts;
---
<Base title="Blog | Privaini" description="Field notes on enforcement, litigation, and what regulators observe from the outside.">
  <section class="head has-field">
    <HairlineField at={{ x: 0.8, y: 0.56 }} />
    <div class="wrap">
      <h1 data-split data-split-now>Privacy &amp; AI risk intelligence.</h1>
      <p class="t-lead sub" data-reveal>Field notes on enforcement, litigation, and what regulators observe from the outside.</p>
    </div>
  </section>

  <section class="feature" aria-label="Latest article">
    <div class="wrap">
      <a class="lead" href={`/post/${lead.slug}`} data-reveal>
        <div class="lead-img"><img src={lead.hero} alt="" width="1200" height="675" data-zoom /></div>
        <div class="lead-copy">
          <span class="cat">{lead.category} · {formatDate(lead.date, lead.dateText)}</span>
          <h2>{lead.title}</h2>
          <p>{lead.summary}</p>
          <span class="by">{lead.author} · {lead.readTime}</span>
        </div>
      </a>
    </div>
  </section>

  <section class="list section" aria-labelledby="all-h" data-blog>
    <div class="wrap">
      <div class="bar">
        <h2 id="all-h">All articles <span class="count nums" data-blog-count>{posts.length - 1}</span></h2>
        <div class="filters" role="group" aria-label="Filter by topic">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
        </div>
      </div>
      <ul role="list" class="rows">
        {rest.map((p) => (
          <li data-cat={p.category}>
            <a href={`/post/${p.slug}`} class="row">
              <span class="date nums">{formatDate(p.date, p.dateText)}</span>
              <span class="mid">
                <span class="cat">{p.category}</span>
                <span class="title">{p.title}</span>
                <span class="sum">{p.summary}</span>
              </span>
              <span class="thumb"><img src={p.hero} alt="" width="320" height="180" loading="lazy" decoding="async" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlank />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-blog]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-cat]')];
    const count = root.querySelector<HTMLElement>('[data-blog-count]')!;
    const apply = (f: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      let n = 0;
      items.forEach((li) => { const on = f === 'all' || li.dataset.cat === f; li.hidden = !on; if (on) n++; });
      count.textContent = String(n);
      window.dispatchEvent(new Event('resize'));
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
    const q = new URLSearchParams(location.search).get('topic');
    if (q && buttons.some((b) => b.dataset.filter === q)) apply(q);
  }
</script>

<style>
  .head { padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 112px)); padding-bottom: clamp(40px, 5vw, 72px); }
  .head h1 { font-size: clamp(44px, 6.4vw, 108px); max-width: 14ch; }
  .sub { margin-top: 24px; color: var(--muted); }
  .lead { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); align-items: end; }
  .lead-img { grid-column: 1 / span 7; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--bg-2); }
  .lead-img img { width: 100%; height: 100%; object-fit: cover; }
  .lead-copy { grid-column: 8 / span 5; display: grid; gap: 16px; align-content: end; padding-bottom: 8px; }
  .lead-copy h2 { font-size: clamp(28px, 2.6vw, 42px); transition: color 0.3s; }
  .lead:hover h2 { color: var(--accent-hi); }
  .lead-copy p { color: var(--muted); font-size: 17px; }
  .cat { font-size: 15px; color: var(--accent-hi); font-weight: 500; }
  .by { font-size: 15px; color: var(--muted); }
  .bar { display: grid; gap: 24px; margin-bottom: 32px; }
  .bar h2 { font-size: clamp(28px, 2.6vw, 40px); display: flex; align-items: baseline; gap: 12px; }
  .count { font-size: 0.5em; color: var(--muted); font-weight: 500; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button {
    height: 40px; padding: 0 16px; border-radius: 999px; background: var(--bg-2); color: var(--muted);
    font-size: 15px; font-weight: 500; transition: background-color 0.2s, color 0.2s;
  }
  .filters button:hover { color: var(--ink); background: var(--bg-3); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .rows { display: grid; gap: 4px; }
  .row {
    display: grid; grid-template-columns: 180px minmax(0, 1fr) 200px; gap: var(--gap); align-items: center;
    padding: 20px; margin-inline: -20px; border-radius: var(--radius); transition: background-color 0.3s var(--ease-out);
  }
  .row:hover { background: var(--bg-2); }
  .date { font-size: 15px; color: var(--muted); align-self: start; padding-top: 4px; }
  .mid { display: grid; gap: 6px; }
  .title { font-size: clamp(20px, 1.7vw, 26px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; transition: color 0.25s; }
  .row:hover .title { color: var(--accent-hi); }
  .sum { color: var(--muted); font-size: 16px; max-width: 70ch; }
  .thumb { aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--bg-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
  .row:hover .thumb img { transform: scale(1.05); }
  @media (max-width: 960px) {
    .lead-img, .lead-copy { grid-column: 1 / -1; }
    .row { grid-template-columns: minmax(0, 1fr) 120px; }
    .date { grid-column: 1 / -1; padding: 0; }
  }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; padding: 16px; margin-inline: -16px; }
    .thumb { grid-row: 1; }
    .sum { display: none; }
  }
</style>
