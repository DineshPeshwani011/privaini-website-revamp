---
// The home page's opening: Privaini's lens as a 3D world (src/scripts/lens/world.ts), held on screen while
// scroll flies the camera through five acts — overview, what you emit, the lens, the briefing, the decisions.
// The poster is a frame of the live world at the top of the hero (a 1905×1080 capture in each theme): it shows
// first, and stays when WebGL or motion is off. Both follow the site theme: dark is the lens as light on navy;
// light is its ink print on paper (world.ts's ink pass).
import { DEMO_URL } from '@/data/site';
import { lensIntro, lensActs as acts, lensChapters as chapters } from '@/data/lens-acts';
---
<section class="lens" data-lens aria-labelledby="lens-h1">
  <div class="stage" data-lens-stage>
    <img class="poster" src="/media/lens/privaini-lens-poster-light.webp" width="1905" height="1080" alt="Privacy signals from a company — cookies, pixels, policy gaps and statutes such as VPPA, BIPA, GDPR and CCPA — stream through the Privaini lens and come out as a risk briefing and a list of next decisions." fetchpriority="high" data-lens-poster />
    <script is:inline>
      (function (img) { if (document.documentElement.dataset.theme === 'dark') img.src = '/media/lens/privaini-lens-poster.webp'; })(document.currentScript.previousElementSibling);
    </script>
    <canvas class="gl" data-lens-canvas aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>

    <div class="act act--intro" data-act="0">
      <h1 id="lens-h1">{lensIntro.title}</h1>
      <p class="lead">{lensIntro.lead}</p>
      <div class="actions">
        <a class="btn" href={DEMO_URL}>See your exposure <span class="arrow">→</span></a>
        <button class="btn btn--ghost" type="button" data-lens-go="1">Look through the lens <span class="arrow">↓</span></button>
      </div>
    </div>

    {acts.map((a, i) => (
      <div class:list={['act', `act--${a.key}`]} data-act={i + 1}>
        <h2>{a.title}</h2>
        <p>{a.text}</p>
        {a.hint && <p class="hint" data-lens-hint>{a.hint}</p>}
        {a.link && <a class="link" href={a.link.href}>{a.link.label} <span class="arrow">→</span></a>}
        {a.cta && <a class="btn" href={DEMO_URL}>See your exposure <span class="arrow">→</span></a>}
      </div>
    ))}

    <nav class="rail" aria-label="Chapters of the lens" data-lens-rail>
      {chapters.map((c, i) => (
        <button type="button" data-lens-go={i} aria-current={i === 0 ? 'step' : undefined}>
          <span class="tick" aria-hidden="true"></span><span class="name">{c}</span>
        </button>
      ))}
    </nav>
    <div class="tip" data-lens-tip role="status" hidden></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { lensWindows as windows, lensChapterAt as chapterAt } from '@/data/lens-acts';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-lens]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-lens-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-lens-canvas]')!;
    const acts = [...root.querySelectorAll<HTMLElement>('[data-act]')];
    const rail = [...root.querySelectorAll<HTMLButtonElement>('[data-lens-rail] [data-lens-go]')];
    const tip = root.querySelector<HTMLElement>('[data-lens-tip]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = matchMedia('(max-width: 760px)').matches;
    // the poster follows the theme (the 3D world switches itself; see world.ts)
    const poster = root.querySelector<HTMLImageElement>('[data-lens-poster]')!;
    addEventListener('privaini:theme', () => {
      poster.src = `/media/lens/privaini-lens-poster${document.documentElement.dataset.theme === 'dark' ? '' : '-light'}.webp`;
    });
    const gl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();

    const vis = (p: number, [a, b, c, d]: [number, number, number, number]) =>
      p <= a || p >= d ? 0 : p < b ? (p - a) / (b - a) : p > c ? 1 - (p - c) / (d - c) : 1;

    const paintActs = (p: number) => {
      acts.forEach((el, i) => {
        const v = vis(p, windows[i]);
        el.style.opacity = String(v);
        el.style.filter = v < 1 ? `blur(${((1 - v) * 10).toFixed(2)}px)` : '';
        el.style.transform = v < 1 ? `translate3d(0, ${((1 - v) * 18).toFixed(1)}px, 0)` : 'none';
        el.style.visibility = v <= 0.001 ? 'hidden' : 'visible';
        el.toggleAttribute('inert', v < 0.5);
      });
      let cur = 0;
      chapterAt.forEach((at, i) => { if (p >= at - 0.06) cur = i; });
      rail.forEach((b, i) => (i === cur ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current')));
      root.style.setProperty('--lens-p', p.toFixed(4));
    };

    const goTo = (i: number) => {
      const top = root.getBoundingClientRect().top + scrollY;
      const span = root.offsetHeight - innerHeight;
      const y = top + span * chapterAt[i];
      const lenis = (window as Window & { lenis?: { scrollTo: (y: number, o?: object) => void } }).lenis;
      if (lenis) lenis.scrollTo(y, { duration: 1.6 }); else scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-lens-go]').forEach((b) => b.addEventListener('click', () => goTo(+b.dataset.lensGo!)));

    if (reduce || !gl) {
      root.classList.add('lens--static');
      acts.forEach((el) => { el.style.opacity = '1'; el.style.visibility = 'visible'; el.removeAttribute('inert'); });
    } else {
      paintActs(0);
      let progress = 0;
      ScrollTrigger.create({
        trigger: root, start: 'top top', end: 'bottom bottom',
        onUpdate: (self) => { progress = self.progress; paintActs(progress); },
      });

      import('@/scripts/lens/world').then(async ({ createLensWorld }) => {
        const world = await createLensWorld(canvas, { mobile });
        // dev only: lets a poster capture render a frame on demand (see docs/BUILD-GUIDE.md)
        if (import.meta.env.DEV) (window as Window & { __lens?: typeof world }).__lens = world;
        root.classList.add('lens--live');
        new ResizeObserver(() => world.resize()).observe(stage);

        let running = false, raf = 0, last = performance.now(), inView = true;
        const loop = (now: number) => {
          const dt = Math.min((now - last) / 1000, 1 / 20);
          last = now;
          world.setProgress(progress);
          world.frame(dt);
          raf = running ? requestAnimationFrame(loop) : 0;
        };
        const sync = () => {
          const want = inView;
          if (want && !running) { running = true; last = performance.now(); raf = requestAnimationFrame(loop); }
          if (!want) { running = false; cancelAnimationFrame(raf); raf = 0; }
        };
        new IntersectionObserver(([e]) => { inView = e.isIntersecting; sync(); }, { rootMargin: '80px' }).observe(stage);
        sync();

        let hovered = -1;
        let hoveredHref: string | undefined;
        const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
        const showTip = (x: number, y: number, title: string, note: string, href?: string) => {
          tip.innerHTML = `<strong>${title}</strong><span>${note}</span>${href ? '<em>Click to read more</em>' : ''}`;
          tip.hidden = false;
          const r = stage.getBoundingClientRect();
          tip.style.transform = `translate(${Math.min(x - r.left + 18, r.width - 300)}px, ${y - r.top + 18}px)`;
        };
        const probe = (e: PointerEvent) => {
          if (progress > 0.4) { if (hovered !== -1) { hovered = -1; world.setHover(null); tip.hidden = true; } return; }
          const hit = world.pick(e.clientX, e.clientY);
          if (hit && hit.signal.note) {
            if (hovered !== hit.index) { hovered = hit.index; world.setHover(hit.index); }
            hoveredHref = hit.signal.href;
            showTip(e.clientX, e.clientY, hit.signal.text, hit.signal.note, hit.signal.href);
            stage.style.cursor = hit.signal.href ? 'pointer' : 'default';
          } else if (hovered !== -1) {
            hovered = -1; hoveredHref = undefined; world.setHover(null); tip.hidden = true; stage.style.cursor = '';
          }
        };
        stage.addEventListener('pointermove', (e) => {
          const r = stage.getBoundingClientRect();
          world.setPointer(((e.clientX - r.left) / r.width) * 2 - 1, -(((e.clientY - r.top) / r.height) * 2 - 1));
          if (fine) probe(e);
        });
        stage.addEventListener('pointerleave', () => { world.setPointer(0, 0); world.setHover(null); hovered = -1; tip.hidden = true; });
        stage.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a, button')) return;
          if (!fine) { probe(e as PointerEvent); return; }
          if (hoveredHref) location.href = hoveredHref;
        });
      }).catch(() => root.classList.add('lens--static'));
    }
  }
</script>

<style>
  /* --base: the shared bottom line of the intro copy and the act rail, so the rail stands level with the lead and CTAs.
     --inset: the content edge of .wrap (the nav and every section), so the copy and rail sit on the page's column on wide screens */
  .lens {
    --base: clamp(40px, 8svh, 96px);
    --inset: max(var(--margin), calc((100% - var(--max)) / 2 + var(--margin)));
    --lead: clamp(17px, 1.25vw, 20px);
    /* the overlay's own palette: the dark theme's lens, and (below) its light print from world.ts's ink pass */
    --ground: #061923;        /* matches the 3D background, shown before it renders */
    --veil: 4, 16, 22;        /* the scrim that keeps the copy legible over the world */
    --halo: 3, 14, 19;        /* the soft backing behind each act's copy, and its density at the centre / midway */
    --halo-in: 0.82;
    --halo-mid: 0.55;
    --type-shadow: rgba(0, 0, 0, 0.55);
    --copy: rgba(225, 242, 246, 0.86);
    --rail-ink: rgba(200, 228, 234, 0.55);
    --poster-out: brightness(0.5);
    position: relative; height: 620svh; background: var(--ground); }
  :global([data-theme='light']) .lens {
    --ground: #f9fcfd;
    --veil: 249, 252, 253;
    --halo: 249, 252, 253;
    --halo-in: 0.92;
    --halo-mid: 0.72;
    --type-shadow: rgba(249, 252, 253, 0.9);
    --copy: var(--muted);
    --rail-ink: rgba(10, 61, 71, 0.45);
    --poster-out: brightness(1.15);
  }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .poster, .gl { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster { object-fit: cover; object-position: 50% 50%; }
  .gl { opacity: 0; filter: blur(18px); }
  /* hand-off: the still image drops out of focus, then the live world racks into focus in its place */
  .lens--live .poster {
    opacity: 0; filter: blur(16px) var(--poster-out); visibility: hidden;
    transition: opacity 0.55s ease-in, filter 0.55s ease-in, visibility 0s 0.6s;
  }
  .lens--live .gl { opacity: 1; filter: none; transition: opacity 1.1s var(--ease-out) 0.4s, filter 1.3s var(--ease-out) 0.4s; }
  .scrim {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(var(--veil), 0.78) 0%, rgba(var(--veil), 0.35) 34%, rgba(var(--veil), 0) 56%),
      linear-gradient(0deg, rgba(var(--veil), 0.85) 0%, rgba(var(--veil), 0) 38%);
  }

  .act {
    position: absolute; z-index: 2; left: var(--inset); max-width: 520px;
    display: grid; gap: 18px; justify-items: start;
  }
  .act::before {
    content: ''; position: absolute; z-index: -1; inset: -90px -120px; pointer-events: none;
    background: radial-gradient(closest-side, rgba(var(--halo), var(--halo-in)), rgba(var(--halo), var(--halo-mid)) 55%, rgba(var(--halo), 0));
  }
  .act--intro::before { inset: -10px -140px -60px; }
  .act h2 { font-size: clamp(32px, 3.4vw, 54px); line-height: 1.02; letter-spacing: -0.035em; text-shadow: 0 2px 30px var(--type-shadow); }
  .act p { color: var(--copy); font-size: var(--lead); line-height: 1.5; text-shadow: 0 1px 18px var(--type-shadow); }
  .act .hint { font-size: 15px; color: var(--accent-hi); }
  .act--intro { bottom: var(--base); max-width: min(1060px, calc(100% - 2 * var(--margin))); }
  .act--intro h1 { font-size: clamp(40px, 5.2vw, 88px); line-height: 0.98; letter-spacing: -0.04em; max-width: 19ch; text-shadow: 0 2px 40px var(--type-shadow); }
  .act--intro .lead { max-width: 52ch; }
  .act--signals { left: auto; right: var(--inset); top: 50%; translate: 0 -50%; }
  .act--lens, .act--briefing, .act--decisions { top: 50%; translate: 0 -50%; }
  .act--lens { max-width: 440px; }

  .rail {
    position: absolute; z-index: 3; right: var(--inset); bottom: var(--base);
    display: grid; gap: 2px; justify-items: end;
  }
  /* padding grows with the lead's font size (3.5px at 17px, 5px at 20px), so the rail spans exactly the lead + CTAs:
     "Overview" level with the lead's first line */
  .rail button { display: flex; align-items: center; gap: 10px; padding: calc(var(--lead) / 2 - 5px) 0; color: var(--rail-ink); font-size: 13.5px; font-weight: 500; transition: color 0.3s; }
  .rail .name { opacity: 0; transform: translateX(6px); transition: opacity 0.3s, transform 0.4s var(--ease-out); }
  .rail:hover .name, .rail button[aria-current] .name { opacity: 1; transform: none; }
  .rail .tick { order: 2; width: 18px; height: 2px; border-radius: 1px; background: currentColor; transition: width 0.4s var(--ease-out), background-color 0.3s; }
  .rail button[aria-current] { color: var(--accent-hi); }
  .rail button[aria-current] .tick { width: 34px; }
  .rail button:hover { color: var(--ink); }

  .tip {
    position: absolute; z-index: 4; left: 0; top: 0; max-width: 280px; pointer-events: none;
    display: grid; gap: 4px; padding: 12px 14px; border-radius: 8px;
    background: rgba(6, 22, 30, 0.92); border: 1px solid rgba(94, 230, 245, 0.35);
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.7), 0 0 24px -6px rgba(94, 230, 245, 0.35);
    font-size: 14px; line-height: 1.4;
  }
  .tip :global(strong) { font-size: 15px; color: #fff; }
  .tip :global(span) { color: rgba(220, 240, 244, 0.85); }
  .tip :global(em) { font-style: normal; font-size: 12.5px; color: var(--accent-hi); }
  :global([data-theme='light']) .tip { background: rgba(255, 255, 255, 0.94); border-color: var(--ui-line-2); box-shadow: var(--ui-shadow); }
  :global([data-theme='light']) .tip :global(strong) { color: var(--strong); }
  :global([data-theme='light']) .tip :global(span) { color: var(--muted); }

  /* without WebGL or with reduced motion: the poster, then the acts as plain sections */
  .lens--static { height: auto; }
  .lens--static .stage { position: relative; height: auto; overflow: visible; padding-top: var(--nav-h); }
  .lens--static .poster { position: relative; height: auto; aspect-ratio: 1905 / 1080; opacity: 1 !important; }
  .lens--static .gl, .lens--static .scrim, .lens--static .rail { display: none; }
  .lens--static .act { position: relative; inset: auto; translate: none; margin: 48px var(--inset) 0; opacity: 1 !important; filter: none !important; transform: none !important; visibility: visible !important; }
  .lens--static .act--intro { margin-top: 32px; }
  .lens--static .act:last-of-type { margin-bottom: 72px; }

  @media (max-width: 760px) {
    .scrim { background: linear-gradient(0deg, rgba(var(--veil), 0.94) 0%, rgba(var(--veil), 0.6) 42%, rgba(var(--veil), 0) 70%); }
    .act, .act--signals, .act--lens, .act--briefing, .act--decisions {
      left: var(--margin); right: var(--margin); top: auto; bottom: 88px; translate: none; max-width: none;
    }
    .act h2 { font-size: 30px; }
    .act p { font-size: 16px; }
    .act--intro { bottom: 88px; }
    .act--intro h1 { font-size: 38px; }
    .rail { left: var(--margin); right: auto; bottom: 28px; grid-auto-flow: column; gap: 6px; }
    .rail .name { display: none; }
    .rail .tick { width: 26px; }
    .rail button[aria-current] .tick { width: 44px; }
    .poster { object-position: 40% 50%; }   /* the lens, centred in a phone-width crop */
  }
</style>
