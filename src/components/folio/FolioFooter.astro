---
// Folio Â· the footer as the current privaini.com sets it out (the /v4 candidate home page): the address and
// contacts on the left, then four columns: the main pages, Solutions, Partners and Legal. Night, square, Urbanist.
// Used through Base's "footer" slot; every other page keeps src/components/Footer.astro. /v5 passes `flat`.
import Wordmark from '@/components/Wordmark.astro';
import { solutions, partners, legal, contact, platform, statutes, resources, PLATFORM_URL, DEMO_URL } from '@/data/site';

interface Props {
  /** Flat (/v5): column titles set plain, and the name set across the whole width as the page's close */
  flat?: boolean;
}
const { flat = false } = Astro.props;

const year = new Date().getFullYear();
const main = [
  { label: 'Risk Intelligence', href: '/risk-intelligence' },
  { label: 'Platform', href: '/platform-overview' },
  { label: 'Company', href: '/about-us' },
  { label: 'Resources', href: '/resources' },
];
// "Privacy Settings": this build sets no cookies, so there is nothing to switch; the link explains that
const legalLinks = [...legal, { label: 'Privacy Settings', href: '/cookie-notice' }];
// Flat: the link groups, laid out after carta.com's footer: a labelled rule over each group; Platform spans three
// columns, each led by a bold entry
const company = [
  { label: 'About us', href: '/about-us' },
  { label: 'Partner program', href: '/partner-program' },
  { label: 'Request a demo', href: DEMO_URL },
  { label: 'Log in', href: PLATFORM_URL },
];
const platformCols = [
  { lead: { label: 'Platform overview', href: '/platform-overview' }, items: platform.filter((l) => l.href !== '/platform-overview') },
  { lead: { label: 'Privacy laws', href: '/state-privacy-laws' }, items: statutes.filter((l) => l.href !== '/state-privacy-laws') },
  { lead: { label: 'Partners', href: '/partner-program' }, items: partners },
];
---
{flat ? (
<footer class="ff ff--flat is-night" data-nav-dark>
  <div class="wrap fz-groups">
    <nav class="fz-g fz-g--1" aria-labelledby="fz-for"><p class="fz-h" id="fz-for">Privaini for</p>
      <ul role="list" class="fz-list fz-list--lead">{solutions.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="fz-g fz-g--3" aria-labelledby="fz-pl"><p class="fz-h" id="fz-pl">Platform</p>
      <div class="fz-cols">
        {platformCols.map((c) => (
          <ul role="list" class="fz-list"><li class="fz-lead"><a href={c.lead.href}>{c.lead.label}</a></li>{c.items.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        ))}
      </div>
    </nav>
    <nav class="fz-g" aria-labelledby="fz-co"><p class="fz-h" id="fz-co">Company</p>
      <ul role="list" class="fz-list">{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="fz-g" aria-labelledby="fz-re"><p class="fz-h" id="fz-re">Resources</p>
      <ul role="list" class="fz-list">{resources.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
  <p class="fz-name" aria-hidden="true">PRIVAINI</p>
  <div class="fz-bar">
    <div class="wrap fz-bar-in">
      <address class="fz-contact">
        <span>Sales <a href={`mailto:${contact.sales}`}>{contact.sales}</a></span>
        <span>Support <a href={`mailto:${contact.support}`}>{contact.support}</a></span>
        <span>{contact.address.join(', ')}</span>
      </address>
      <a class="fz-cta" href={DEMO_URL}>See your exposure</a>
    </div>
  </div>
  <div class="wrap fz-base">
    <p class="fz-copy">Â© {year} Privaini Inc. All rights reserved.</p>
    <nav aria-label="Legal"><ul role="list" class="fz-legal">{legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></nav>
  </div>
</footer>
) : (
<footer class="ff is-night" data-nav-dark>
  <div class="wrap ff-grid">
    <div class="ff-intro">
      <a href="/" class="ff-mark" aria-label="Privaini home"><Wordmark size="md" /></a>
      <address>{contact.address.map((line) => <span>{line}</span>)}</address>
      <p class="ff-mail">
        <span>Sales: <a href={`mailto:${contact.sales}`}>{contact.sales}</a></span>
        <span>Support: <a href={`mailto:${contact.support}`}>{contact.support}</a></span>
      </p>
      <p class="ff-copy">Â© {year} Privaini Inc. All rights reserved.</p>
    </div>
    <nav class="ff-col ff-main" aria-label="Main pages">
      <ul role="list">{main.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="ff-col" aria-label="Solutions">
      <p class="ff-title">Solutions</p>
      <ul role="list">{solutions.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="ff-col" aria-label="Partners">
      <p class="ff-title">Partners</p>
      <ul role="list">{partners.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="ff-col" aria-label="Legal">
      <p class="ff-title">Legal</p>
      <ul role="list">{legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
</footer>
)}

<script>
  // the faded name arrives once, when it scrolls into view
  const name = document.querySelector<HTMLElement>('.fz-name');
  if (name) {
    if (!('IntersectionObserver' in window)) name.classList.add('in');
    else {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { name.classList.add('in'); io.disconnect(); } }), { threshold: 0.35 });
      io.observe(name);
    }
  }
</script>

<style>
  .ff { padding-block: clamp(72px, 8vw, 120px) clamp(48px, 5vw, 72px); border-top: 1px solid var(--on-night-line); }
  .ff-grid { display: grid; grid-template-columns: minmax(0, 5fr) repeat(4, minmax(0, 2fr)); gap: clamp(32px, 3vw, 56px) var(--gap); align-items: start; }
  .ff-intro { display: grid; gap: 24px; justify-items: start; font-size: 14px; line-height: 1.6; color: var(--on-night-muted); }
  .ff-mark { color: var(--on-night); margin-bottom: 8px; }
  address { display: grid; font-style: normal; }
  .ff-mail { display: grid; gap: 4px; margin: 0; }
  .ff-mail a, .ff-col a { transition: color 0.3s; }
  .ff-mail a:hover, .ff-col a:hover { color: var(--cyan-soft); }
  .ff a:focus-visible { outline: 2px solid var(--cyan-soft); outline-offset: 4px; }
  .ff a:active { opacity: 0.75; }
  .ff-copy { margin: 0; font-size: 13px; }
  .ff-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ff-title { margin: 0 0 20px; font: italic 400 15px/1.4 var(--font); color: var(--cyan-soft); }
  .ff-col a { font-size: 15px; color: var(--on-night); }
  /* the main pages, set larger: they are the column's titles */
  .ff-main ul { gap: 16px; }
  .ff-main a { font-size: clamp(19px, 1.5vw, 23px); letter-spacing: -0.02em; }
  @media (max-width: 899px) {
    .ff-grid { grid-template-columns: 1fr 1fr; }
    .ff-intro { grid-column: 1 / -1; }
  }

  /* ---- Flat (/v5): carta.com's footer. Labelled groups on a four-column grid, a bar, then the base line; the
     name sits behind it all, large and faint, fading out towards the foot ---- */
  .ff--flat { position: relative; overflow: clip; border-top: 0; padding: clamp(80px, 8vw, 120px) 0 0; isolation: isolate; }
  .fz-name {
    /* equal space above and below: the line box is cut to the capitals (0.72em), so the margins are the whole gap */
    margin: clamp(24px, 3vw, 48px) 0; text-align: center; pointer-events: none; user-select: none;
    transition: opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1), translate 1.4s cubic-bezier(0.22, 1, 0.36, 1);
    font: 400 64px/48px var(--logo); letter-spacing: 0.02em; white-space: nowrap; color: var(--on-night); opacity: 0.12;
    -webkit-mask-image: linear-gradient(180deg, #000 30%, rgba(0, 0, 0, 0.3) 100%); mask-image: linear-gradient(180deg, #000 30%, rgba(0, 0, 0, 0.3) 100%);
  }
  .fz-groups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(64px, 6vw, 96px) var(--gap); align-items: start; }
  .fz-g--3 { grid-column: span 3; }
  .fz-h {
    display: flex; align-items: center; gap: 12px; margin: 0 0 20px; padding-bottom: 12px; border-bottom: 1px solid var(--on-night-line-2);
    font: 500 14px/20px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-night);
  }
  .fz-h::before { content: ''; flex: none; width: 8px; height: 8px; background: var(--on-night); }
  .fz-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 32px; }
  .fz-list { list-style: none; margin: 0; padding: 0; display: grid; align-content: start; gap: 8px; font-size: 14px; line-height: 20px; color: var(--on-night-muted); }
  .fz-list--lead, .fz-lead { color: var(--on-night); font-weight: 600; }
  .fz-lead { margin-bottom: 2px; }
  .fz-contact { display: flex; flex-wrap: wrap; gap: 8px 32px; font-style: normal; font-size: 14px; line-height: 20px; color: var(--on-night-muted); }
  .fz-contact a { color: var(--on-night); margin-left: 6px; }
  .ff--flat a { transition: color 0.25s; }
  .ff--flat a:hover { color: var(--on-night); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .ff--flat a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }
  .ff--flat a:active { opacity: 0.75; }
  /* the faded name is decorative; its size steps on the 4-point grid, with its line height cut to the capitals */
  @media (min-width: 768px) { .fz-name { font-size: 120px; line-height: 88px; } }
  @media (min-width: 1024px) { .fz-name { font-size: 160px; line-height: 116px; } }
  @media (min-width: 1280px) { .fz-name { font-size: 200px; line-height: 144px; } }
  @media (min-width: 1440px) { .fz-name { font-size: 224px; line-height: 160px; } }
  @media (min-width: 1600px) { .fz-name { font-size: 256px; line-height: 184px; } }
  /* scroll reveal: it rises and fades up to its resting 12% when the footer's close comes into view */
  :global(html.js) .fz-name:not(.in) { opacity: 0; translate: 0 36px; }
  @media (prefers-reduced-motion: reduce) { :global(html.js) .fz-name:not(.in) { translate: none; } }
  .fz-bar { margin-top: 0; border-block: 1px solid var(--on-night-line); }
  .fz-bar-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; min-height: 72px; padding-block: 14px; }
  .fz-cta { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1px solid var(--on-night-line-2); font-size: 14px; line-height: 20px; color: var(--on-night); }
  .ff--flat .fz-cta:hover { background: var(--cyan); border-color: var(--cyan); color: var(--night); text-decoration: none; }
  .fz-base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-block: 28px 32px; }
  .fz-copy { margin: 0; font: 500 14px/20px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-night-muted); }
  .fz-legal { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 14px; line-height: 20px; color: var(--on-night-muted); }
  @media (max-width: 1099px) {
    .fz-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fz-g--3 { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .fz-groups { grid-template-columns: 1fr; }
    .fz-cols { grid-template-columns: 1fr 1fr; }
    .fz-cols ul:last-child { grid-column: 1 / -1; }
  }
</style>
