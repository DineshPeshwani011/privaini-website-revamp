---
// Folio · the risk picture: from your company name and website to the decisions it supports, drawn as a live
// hairline instrument. Your company sends out a pulse; each signal it gives off (pixels, cookies, policies and the
// statutes they meet) locks on as the pulse reaches it, and its data runs down a wire into the Privaini lens. The
// lens focuses, its rings turn, a sweep scans, and each thing it brings to bear locks on and decodes. A beam carries
// the result into the risk briefing, which a scan line compiles tile by tile (findings, exposure, evidence,
// remediation); from it, a fan of lines ticks your next decisions one by one. A rail along the foot tracks the run.
// Every label is the current privaini.com's. VPPA and BIPA stay bracketed: they are the briefing's findings.
// Wide (1100px and up): one plate, every part placed on a 1312 by 620 grid in container units (--u), with the
// wires drawn in one SVG on the same grid. src/scripts/risk-picture.ts plays it as the scroll holds the chapter,
// then leaves it running (packets on the wires, the lens turning). Narrower: the same parts stacked, each played
// once as it comes into view. Under reduced motion it is all simply there, still.
// Square everywhere but the lens.

// the signals, in rows around the company: [label, x, row centre y, highlighted]
const signals: [string, number, number, boolean?][] = [
  ['Cookies', 60, 88], ['Meta pixels', 180, 88],
  ['GLBA', 0, 143], ['CIPA', 110, 143], ['VPPA', 220, 143, true],
  ['Policy Gaps', 16, 198], ['LGPD', 140, 198], ['Digital Properties', 205, 198],
  ['CPRA', 250, 253],
  ['GDPR', 0, 308], ['CCPA', 250, 308],
  ['CTDPA', 30, 370], ['Device Fingerprints', 160, 370],
  ['PIPEDA', 0, 425], ['HIPAA', 110, 425], ['BIPA', 220, 425, true],
  ['Dark Patterns', 20, 480], ['Wiretap', 150, 480], ['EU AI Act', 230, 480],
  ['Wrongful Collection', 60, 535],
];
// one wire from each row of signals into the lens: along, then in to the lens's left edge; a packet runs each
const rows = [88, 143, 198, 253, 308, 370, 425, 480, 535];
const hotRows = new Set(signals.filter((s) => s[3]).map((s) => s[2]));
const LENS = { x: 610, y: 310, r: 120, orbit: 160 };
const wires = rows.map((y, i) => ({
  d: `M322 ${y}H372L${LENS.x - LENS.r} ${LENS.y + (i - 4) * 5}`,
  hot: hotRows.has(y),
  t: (2.3 + ((i * 5) % 7) * 0.19).toFixed(2),
  delay: (-((i * 11) % 9) * 0.31).toFixed(2),
}));
const beam = `M${LENS.x + LENS.r} ${LENS.y}H872`;

// what the lens brings to bear, round its orbit: [label, angle from the top, label anchor]
const caps: [string, number, 'start' | 'middle' | 'end'][] = [
  ['Regulatory Repository', 10, 'start'],
  ['Market Observations', 50, 'start'],
  ['AI Transparency', 110, 'start'],
  ['Jurisdiction Mapping', 145, 'start'],
  ['Evidence Collection', 185, 'middle'],
  ['Litigation Patterns', 210, 'end'],
  ['Technology Detection', 335, 'end'],
];
const rad = (a: number) => (a * Math.PI) / 180;
const onOrbit = (a: number, r = LENS.orbit) => [LENS.x + r * Math.sin(rad(a)), LENS.y - r * Math.cos(rad(a))];
const capAt = caps.map(([label, a, anchor]) => {
  const [x, y] = onOrbit(a, LENS.orbit + 16);
  return { label, x: anchor === 'end' ? x - 4 : anchor === 'start' ? x + 4 : x, y: a > 90 && a < 270 ? y + 10 : y - 8, tx: anchor === 'end' ? '-100%' : anchor === 'middle' ? '-50%' : '0' };
});

// the lens's own drawing, in a 340 box centred on the lens
const C = 170;
const f = (n: number) => Number(n.toFixed(1));
const pt = (r: number, a: number) => [f(C + r * Math.sin(rad(a))), f(C - r * Math.cos(rad(a)))];
const radial = (r0: number, r1: number, a: number) => { const [x0, y0] = pt(r0, a); const [x1, y1] = pt(r1, a); return `M${x0} ${y0}L${x1} ${y1}`; };
const arc = (r: number, a0: number, a1: number) => { const [x0, y0] = pt(r, a0); const [x1, y1] = pt(r, a1); return `M${x0} ${y0}A${r} ${r} 0 0 1 ${x1} ${y1}`; };
// three turning segments between the ring and the orbit, each with an end tick at both ends
const hud = [[18, 92], [138, 212], [258, 332]].map(([a0, a1]) => arc(142, a0, a1) + radial(137, 147, a0) + radial(137, 147, a1)).join('');
// the sweep: a leading hairline and its fading trail
const sweep = Array.from({ length: 14 }, (_, k) => ({ a: f(-k * 2.4), o: (0.62 * (1 - k / 14) ** 1.8).toFixed(3) }));
// each capability: a spoke out from the ring, a node on the orbit, and the square that locks onto it
const capNodes = caps.map(([, a]) => ({ spoke: radial(124, 154, a), at: pt(LENS.orbit, a) }));

// the decisions, and the fan that runs out of the briefing to each of them
const decisions = ['Fix what matters first', 'Quantify exposure', 'Brief the board', 'Price or transfer risk', 'Deal Diligence'];
const DEC = { x: 1152, head: 190, rows: [238, 274, 310, 346, 382] };
const fan = DEC.rows.map((y, i) => ({ d: `M1110 310H1120L1140 ${y}H1150`, delay: (-i * 0.37).toFixed(2) }));
// the run's rail along the foot: one mark under each stage (company, lens, briefing, decisions)
const marks = [150, 610, 995, 1231];

// the evidence tile's trace and the exposure tile's bars (tile drawings, 100 by 40)
const evidence = 'M0 36H14V30H28V33H42V22H56V25H70V12H84V16H100';
const bars = [10, 16, 13, 24, 30];
---
<div class="rp" data-rp role="img" aria-label="From your company's website, the signals it gives off (cookies, pixels, policies and the statutes they meet: GDPR, CCPA, VPPA, BIPA and more) run into the Privaini lens, which brings a regulatory repository, technology detection, market observations, AI transparency, jurisdiction mapping, evidence collection and litigation patterns to bear. Out comes the Privaini risk briefing: findings, exposure, evidence and remediation. From it, your next decisions: fix what matters first, quantify exposure, brief the board, price or transfer risk, deal diligence.">
  <svg class="rp-grid" viewBox="0 0 1312 620" aria-hidden="true">
    <defs><pattern id="rp-dots" width="24" height="24" patternUnits="userSpaceOnUse"><rect x="11.5" y="11.5" width="1" height="1" /></pattern></defs>
    <rect width="1312" height="620" fill="url(#rp-dots)" />
  </svg>

  <svg class="rp-wires" viewBox="0 0 1312 620" aria-hidden="true">
    <path class="rp-rail" d="M0 604H1312" />
    <path class="rp-rail-fill" d="M0 604H1312" pathLength="1" data-rp-rail />
    {marks.map((x) => <rect class="rp-mk" x={x - 3.5} y="600.5" width="7" height="7" data-rp-mark />)}

    {wires.map((w) => <path class:list={['rp-wire', { hot: w.hot }]} d={w.d} pathLength="1" data-rp-wire />)}
    {wires.map((w) => <path class:list={['rp-pk rp-pk--in', { hot: w.hot }]} d={w.d} pathLength="1" style={`--t: ${w.t}s; --d: ${w.delay}s`} />)}

    <path class="rp-out" d={beam} pathLength="1" data-rp-beam />
    <path class="rp-head" d="M866 304 874 310 866 316" pathLength="1" data-rp-beam />
    {['0', '-0.7'].map((d) => <path class="rp-pk rp-pk--out" d={beam} pathLength="1" style={`--t: 1.4s; --d: ${d}s; --dl: 0.05`} />)}

    {fan.map((b) => <path class="rp-fan" d={b.d} pathLength="1" data-rp-fan />)}
    {fan.map((b) => <path class="rp-pk rp-pk--fan" d={b.d} pathLength="1" style={`--t: 1.85s; --d: ${b.delay}s; --dl: 0.12`} />)}
  </svg>

  <div class="rp-src" aria-hidden="true">
    <p class="rp-company at" style="--x: 70; --y: 310"><span class="rp-emit"></span><span class="rp-echo"></span><span class="rp-echo"></span>Your Company</p>
    <ul class="rp-sig" role="list">
      {signals.map(([label, x, y, hot]) => (
        <li class:list={['at', { hot }]} style={`--x: ${x}; --y: ${y}`} data-row={rows.indexOf(y)} data-rp-sig>{label}</li>
      ))}
    </ul>
  </div>

  <div class="rp-lens" aria-hidden="true">
    <svg class="rp-ring at" style="--x: 440; --y: 310" viewBox="0 0 340 340">
      <circle class="rl-orbit" cx={C} cy={C} r={LENS.orbit} />
      <g data-rp-focus>
        <g class="rl-spin rl-spin--hud"><path class="rl-hud" d={hud} /></g>
        <g data-rp-ticks><g class="rl-spin rl-spin--ticks"><circle class="rl-ticks" cx={C} cy={C} r="106" pathLength="96" /></g></g>
        <g class="rl-spin rl-spin--inner"><circle class="rl-inner" cx={C} cy={C} r="80" /></g>
        <circle class="rl-core" cx={C} cy={C} r="48" />
        <g class="rl-sweep"><g class="rl-spin rl-spin--sweep">
          {sweep.map((s) => <path d={`M${C} ${C - 54}V${C - 116}`} transform={`rotate(${s.a} ${C} ${C})`} style={`opacity: ${s.o}`} />)}
        </g></g>
        <circle class="rl-ring" cx={C} cy={C} r={LENS.r} />
        <path class="rl-cross" d={`M${C} ${C - LENS.r - 14}V${C - LENS.r - 5}M${C} ${C + LENS.r + 5}V${C + LENS.r + 14}M${C - LENS.r - 14} ${C}H${C - LENS.r - 5}M${C + LENS.r + 5} ${C}H${C + LENS.r + 14}`} />
      </g>
      {capNodes.map((n) => (
        <g class="rl-cap" data-rp-node>
          <path class="rl-spoke" d={n.spoke} pathLength="1" />
          <rect class="rl-lock" x={n.at[0] - 7} y={n.at[1] - 7} width="14" height="14" />
          <rect class="rl-node" x={n.at[0] - 3} y={n.at[1] - 3} width="6" height="6" />
        </g>
      ))}
    </svg>
    <span class="rp-mark at" style="--x: 610; --y: 310; --tx: -50%">PRIV<b>AI</b>NI</span>
    <ul class="rp-caps" role="list">
      {capAt.map((c) => <li class="at" style={`--x: ${c.x.toFixed(1)}; --y: ${c.y.toFixed(1)}; --tx: ${c.tx}`} data-rp-cap>{c.label}</li>)}
    </ul>
  </div>

  <div class="rp-brief at" style="--x: 880; --y: 310" aria-hidden="true">
    <i class="rb-scan"></i><i class="rb-rescan"></i>
    <p class="rb-chip" data-rp-chip><i></i><span data-rp-events>14</span> events captured</p>
    <p class="rb-head"><i></i><span data-rp-head>Privaini Risk Briefing</span></p>
    <div class="rb-tiles">
      <div class="rb-tile" data-rp-tile>
        <p class="rb-t">Findings</p>
        <p class="rb-tags"><span class="rb-tag rb-tag--fill">High</span><span class="rb-tag">VPPA</span></p>
        <p class="rb-mono"><span>US-CA</span><span>US-IL</span></p>
      </div>
      <div class="rb-tile" data-rp-tile>
        <p class="rb-t">Exposure</p>
        <p class="rb-fig">$<span data-rp-exposure>22.5</span>M</p>
        <svg class="rb-draw rb-bars" viewBox="0 0 100 40" preserveAspectRatio="none">{bars.map((h, i) => <rect x={i * 20 + 4} y={40 - h} width="12" height={h} style={`--i: ${i}`} />)}</svg>
      </div>
      <div class="rb-tile" data-rp-tile>
        <p class="rb-t">Evidence</p>
        <div class="rb-ev">
          <svg class="rb-draw" viewBox="0 0 100 40" preserveAspectRatio="none"><path d={evidence} /><path class="rb-base" d="M0 39.5H100" /></svg>
          <i class="rb-cur"></i>
        </div>
      </div>
      <div class="rb-tile" data-rp-tile>
        <p class="rb-t">Remediation</p>
        <ul class="rb-steps" role="list"><li><i></i>Immediate</li><li class="on"><i></i>Staged</li></ul>
      </div>
    </div>
  </div>

  <div class="rp-decide" aria-hidden="true">
    <p class="rd-head at" style={`--x: ${DEC.x}; --y: ${DEC.head}`}>Your Next Decisions</p>
    <ul role="list">
      {decisions.map((d, i) => (
        <li class="at" style={`--x: ${DEC.x}; --y: ${DEC.rows[i]}`} data-rp-dec><i class="rd-box"><svg viewBox="0 0 12 12"><path d="M2.5 6.5 5 9 9.5 3" pathLength="1" /></svg></i>{d}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* ---- the plate: every part on a 1312 by 620 grid; --u is one grid unit ---- */
  .rp {
    --u: calc(100cqw / 1312); --c-hot: var(--cyan-soft); --c-dim: rgba(103, 214, 230, 0.4);
    position: relative; width: 100%; aspect-ratio: 1312 / 620; container-type: inline-size; color: var(--on-night);
  }
  .rp p, .rp ul { margin: 0; padding: 0; list-style: none; }
  .at { position: absolute; left: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u)); translate: var(--tx, 0) -50%; white-space: nowrap; }

  /* corner brackets, drawn as eight 1px bars: any part that wants them sets --bk (arm length) and --c (colour) */
  .rp-company::after, .rp-sig li::after, .rp-brief::after, .rd-box::after {
    content: ''; position: absolute; pointer-events: none;
    background:
      linear-gradient(var(--c), var(--c)) left top / var(--bk) 1px, linear-gradient(var(--c), var(--c)) left top / 1px var(--bk),
      linear-gradient(var(--c), var(--c)) right top / var(--bk) 1px, linear-gradient(var(--c), var(--c)) right top / 1px var(--bk),
      linear-gradient(var(--c), var(--c)) left bottom / var(--bk) 1px, linear-gradient(var(--c), var(--c)) left bottom / 1px var(--bk),
      linear-gradient(var(--c), var(--c)) right bottom / var(--bk) 1px, linear-gradient(var(--c), var(--c)) right bottom / 1px var(--bk);
    background-repeat: no-repeat;
  }

  /* the measuring field: a faint grid of points, fading out to the plate's edges */
  .rp-grid {
    position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--on-night); opacity: 0.16; pointer-events: none;
    mask-image: radial-gradient(closest-side at 50% 50%, #000 35%, transparent);
  }

  .rp-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .rp-wires path { fill: none; stroke-width: 1; }
  .rp-wire { stroke: rgba(232, 236, 233, 0.2); stroke-dasharray: 1 1; transition: stroke 0.3s; }
  .rp-wire.hot { stroke: var(--c-dim); }
  .rp-wire.hl { stroke: var(--cyan-soft); }
  .rp-out, .rp-head { stroke: var(--cyan-soft); stroke-dasharray: 1 1; }
  .rp-fan { stroke: var(--c-dim); stroke-dasharray: 1 1; }
  /* a packet: one short dash run down its wire (the long gap keeps the next one off the wire) */
  .rp-wires .rp-pk { stroke: rgba(232, 236, 233, 0.85); stroke-width: 2; stroke-dasharray: var(--dl, 0.026) 2; stroke-dashoffset: 0.2; opacity: 0; }
  .rp-wires .rp-pk.hot, .rp-wires .rp-pk--out, .rp-wires .rp-pk--fan { stroke: var(--cyan-soft); }
  .rp-rail { stroke: var(--on-night-line); }
  .rp-rail-fill { stroke: var(--c-dim); stroke-dasharray: 1 1; }
  .rp-mk { fill: var(--cyan-soft); stroke: var(--cyan-soft); stroke-width: 1; transition: fill 0.3s; }
  .rp.is-armed .rp-mk:not(.on) { fill: var(--night); stroke: var(--on-night-muted); }

  /* the company, its pulse, and the signals round it */
  .rp-company {
    width: calc(160 * var(--u)); padding: calc(13 * var(--u)) 0; text-align: center; background: var(--night); border: 1px solid var(--on-night-muted);
    font: 500 max(11px, calc(15 * var(--u)))/1 var(--font); letter-spacing: -0.01em; isolation: isolate;
  }
  .rp-company::after { inset: calc(-7 * var(--u)); --bk: max(6px, calc(9 * var(--u))); --c: var(--cyan-soft); }
  .rp-emit, .rp-echo { position: absolute; inset: 0; z-index: -1; border: 1px solid var(--cyan-soft); opacity: 0; pointer-events: none; }
  /* the first pulse is the scroll's: --e (0 to 1) grows it out over the signals, which lock on as it reaches them */
  .rp.is-armed .rp-emit {
    inset: calc(var(--e, 0) * -240 * var(--u)) calc(var(--e, 0) * -80 * var(--u));
    opacity: calc(min(var(--e, 0) * 12, 1) * (1 - var(--e, 0)) * 0.75);
  }
  .rp-sig li { display: flex; align-items: center; gap: calc(6 * var(--u)); font: 400 max(10px, calc(12.5 * var(--u)))/1.3 var(--font); color: var(--on-night-muted); transition: opacity 0.4s, color 0.4s; }
  .rp-sig li::before { content: ''; flex: none; width: calc(4 * var(--u)); height: calc(4 * var(--u)); min-width: 3px; min-height: 3px; background: currentColor; opacity: 0.6; }
  .rp-sig li::after { inset: calc(-5 * var(--u)) calc(-7 * var(--u)); --bk: max(4px, calc(5 * var(--u))); --c: var(--cyan-soft); opacity: 0; transition: opacity 0.3s; }
  .rp-sig li.hot { color: var(--cyan-soft); }
  .rp-sig li.hot::after, .rp-sig li.hl::after { opacity: 1; }
  .rp-sig li.hl { color: var(--on-night); }
  .rp.is-armed .rp-sig li:not(.on) { opacity: 0.18; }
  .rp.is-armed .rp-sig li:not(.on)::after { opacity: 0; }

  /* the lens: the one round drawing */
  .rp-ring { width: calc(340 * var(--u)); height: calc(340 * var(--u)); overflow: visible; }
  .rp-ring circle, .rp-ring path { fill: none; }
  .rl-orbit { stroke: var(--on-night-line); stroke-dasharray: 2 6; }
  .rl-hud { stroke: rgba(103, 214, 230, 0.34); }
  .rl-ticks { stroke: rgba(103, 214, 230, 0.4); stroke-width: 6; stroke-dasharray: 0.08 0.92; }
  .rl-inner { stroke: rgba(103, 214, 230, 0.3); stroke-dasharray: 3 5; }
  .rl-core { fill: rgba(7, 188, 212, 0.06) !important; stroke: rgba(103, 214, 230, 0.25); }
  .rl-ring { stroke: var(--cyan-soft); stroke-width: 1.5; }
  .rl-cross { stroke: var(--cyan-soft); }
  .rl-sweep { opacity: 0; transition: opacity 0.9s; }
  .rl-sweep path { stroke: var(--cyan-soft); }
  .rl-spin { transform-box: view-box; transform-origin: 50% 50%; }
  .rl-spoke { stroke: rgba(103, 214, 230, 0.45); stroke-dasharray: 1 1; transition: stroke-dashoffset 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .rl-node { fill: var(--cyan-soft); transition: fill 0.3s; }
  .rl-lock { fill: none !important; stroke: var(--cyan-soft); opacity: 0.55; transform-box: fill-box; transform-origin: center; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s; }
  .rl-cap.hl .rl-lock { opacity: 1; transform: scale(1.4); }
  .rp.is-armed .rl-cap:not(.on) .rl-spoke { stroke-dashoffset: 1; }
  .rp.is-armed .rl-cap:not(.on) .rl-lock { opacity: 0; transform: scale(2.6); }
  .rp.is-armed .rl-cap:not(.on) .rl-node { fill: var(--on-night-line); }
  .rp-mark { font: 400 max(12px, calc(21 * var(--u)))/1 var(--logo); letter-spacing: 0.06em; color: var(--on-night); transition: opacity 0.6s; }
  .rp-mark b { font-weight: 400; color: var(--cyan); }
  .rp.is-armed:not(.st-lens) .rp-mark { opacity: 0.35; }
  .rp-caps li { font: 400 max(10px, calc(12.5 * var(--u)))/1.3 var(--font); color: var(--on-night); transition: opacity 0.4s, color 0.3s; }
  .rp-caps li.hl { color: var(--cyan-soft); }
  .rp.is-armed .rp-caps li:not(.on) { opacity: 0; }

  /* the briefing */
  .rp-brief {
    width: calc(230 * var(--u)); height: calc(360 * var(--u)); display: grid; grid-template-rows: auto 1fr; gap: calc(10 * var(--u));
    padding: calc(12 * var(--u)); background: var(--night-2); border: 1px solid var(--on-night-line); white-space: normal;
  }
  .rp-brief::after { inset: calc(-7 * var(--u)); --bk: max(8px, calc(12 * var(--u))); --c: rgba(103, 214, 230, 0.55); }
  /* the scan line that compiles it (--scan, 0 to 1), and later its quiet rescans */
  .rb-scan, .rb-rescan { position: absolute; z-index: 2; left: calc(-7 * var(--u)); right: calc(-7 * var(--u)); top: 0; height: 1px; background: var(--cyan-soft); opacity: 0; pointer-events: none; }
  .rb-scan { top: calc(var(--scan, 0) * 100%); transition: opacity 0.2s; }
  .rp-brief.is-scanning .rb-scan { opacity: 1; }
  .rb-chip {
    position: absolute; z-index: 1; right: calc(-14 * var(--u)); top: calc(-16 * var(--u)); display: flex; align-items: center; gap: calc(6 * var(--u));
    padding: calc(6 * var(--u)) calc(10 * var(--u)); background: var(--night); border: 1px solid rgba(103, 214, 230, 0.5);
    font: 500 max(9.5px, calc(11.5 * var(--u)))/1 var(--font); color: var(--on-night); white-space: nowrap; transition: opacity 0.4s;
  }
  .rb-chip i { width: calc(5 * var(--u)); height: calc(5 * var(--u)); min-width: 4px; min-height: 4px; background: var(--cyan); }
  .rb-chip span { font-variant-numeric: tabular-nums; color: var(--cyan-soft); min-width: 2ch; text-align: right; }
  .rp.is-armed .rb-chip:not(.on) { opacity: 0; }
  .rb-head { display: flex; align-items: center; gap: calc(8 * var(--u)); font: 500 max(10px, calc(13 * var(--u)))/1.2 var(--font); padding-bottom: calc(10 * var(--u)); border-bottom: 1px solid var(--on-night-line); }
  .rb-head i { width: calc(6 * var(--u)); height: calc(6 * var(--u)); min-width: 4px; min-height: 4px; background: var(--cyan); }
  .rb-tiles { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: calc(8 * var(--u)); min-height: 0; }
  .rb-tile {
    display: grid; align-content: start; gap: calc(8 * var(--u)); padding: calc(10 * var(--u)); border: 1px solid var(--on-night-line); background: var(--night); min-width: 0;
    transition: opacity 0.5s, translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rb-t { font: 500 max(9.5px, calc(11.5 * var(--u)))/1 var(--font); color: var(--on-night-muted); }
  .rb-tags { display: flex; flex-wrap: wrap; gap: calc(5 * var(--u)); }
  .rb-tag { padding: calc(3 * var(--u)) calc(5 * var(--u)); border: 1px solid var(--on-night-muted); font: 600 max(8.5px, calc(9.5 * var(--u)))/1 var(--font); letter-spacing: 0.06em; text-transform: uppercase; }
