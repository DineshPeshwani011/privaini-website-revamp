---
// The hero's live fragment: an outside-in scan of the page the visitor is reading, computed in
// their browser from what this page actually loaded. Nothing here is simulated.
---
<div class="scan" data-ui data-scan>
  <div class="ui-head">
    <div class="who">
      <span class="ui-dot pulse" aria-hidden="true"></span>
      <span class="ui-label">Live scan</span>
      <span class="host ui-mono" data-scan-host>privaini.com</span>
    </div>
    <span class="ui-mono ui-muted" data-scan-time>--:--:-- UTC</span>
  </div>
  <div class="progress" aria-hidden="true"><i data-scan-bar></i></div>
  <ul role="list" class="rows" aria-live="polite">
    <li class="ui-row" data-check="thirdParty">
      <span class="ui-label">Third-party hosts contacted</span><span class="val ui-mono">—</span><span class="mark"></span>
    </li>
    <li class="ui-row" data-check="trackers">
      <span class="ui-label">Ad &amp; analytics trackers</span><span class="val ui-mono">—</span><span class="mark"></span>
    </li>
    <li class="ui-row" data-check="replay">
      <span class="ui-label">Session-replay scripts</span><span class="val ui-mono">—</span><span class="mark"></span>
    </li>
    <li class="ui-row" data-check="cookies">
      <span class="ui-label">Cookies readable by scripts</span><span class="val ui-mono">—</span><span class="mark"></span>
    </li>
    <li class="ui-row" data-check="gpc">
      <span class="ui-label">Global Privacy Control signal</span><span class="val ui-mono">—</span><span class="mark"></span>
    </li>
    <li class="ui-row" data-check="requests">
      <span class="ui-label">Requests observed</span><span class="val ui-mono">—</span><span class="mark"></span>
    </li>
  </ul>
  <div class="result">
    <div class="ui-kv">
      <span class="ui-label">Result for this page</span>
      <span class="ui-value" data-scan-result>Scanning…</span>
    </div>
    <button class="ui-btn" type="button" data-scan-again>Rescan</button>
  </div>
  <form class="domain" action="/request-a-demo" method="get">
    <label class="ui-label" for="scan-domain">Now see what regulators see on your domain</label>
    <div class="field">
      <input id="scan-domain" name="domain" type="text" inputmode="url" autocomplete="url" placeholder="your-company.com" spellcheck="false" />
      <button class="ui-btn ui-btn--primary" type="submit">See your exposure</button>
    </div>
  </form>
</div>

<script>
  const TRACKERS = /(google-analytics|googletagmanager|doubleclick|googlesyndication|facebook\.(net|com)|fbcdn|connect\.facebook|tiktok|analytics\.twitter|ads-twitter|snap\.licdn|linkedin\.com\/(px|li)|bat\.bing|criteo|taboola|outbrain|adnxs|segment\.(io|com)|mixpanel|amplitude|heap(analytics)?|hubspot|hs-analytics|pardot|marketo|quantserve|scorecardresearch|cookiebot|onetrust|clarity\.ms)/i;
  const REPLAY = /(hotjar|fullstory|clarity\.ms|logrocket|smartlook|mouseflow|quantummetric|contentsquare|inspectlet|luckyorange|crazyegg)/i;

  const root = document.querySelector<HTMLElement>('[data-scan]');
  if (root) {
    const rows = [...root.querySelectorAll<HTMLElement>('[data-check]')];
    const bar = root.querySelector<HTMLElement>('[data-scan-bar]')!;
    const result = root.querySelector<HTMLElement>('[data-scan-result]')!;
    const time = root.querySelector<HTMLElement>('[data-scan-time]')!;
    root.querySelector('[data-scan-host]')!.textContent = location.host || 'privaini.com';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const measure = () => {
      const entries = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const urls = entries.map((e) => e.name);
      const hosts = new Set<string>();
      urls.forEach((u) => { try { const h = new URL(u).host; if (h && h !== location.host) hosts.add(h); } catch {} });
      const trackers = urls.filter((u) => TRACKERS.test(u));
      const replay = urls.filter((u) => REPLAY.test(u));
      const cookies = document.cookie ? document.cookie.split(';').filter((c) => c.trim()).length : 0;
      const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
      return {
        thirdParty: { val: String(hosts.size), ok: hosts.size === 0 },
        trackers: { val: trackers.length ? `${trackers.length} found` : 'none', ok: trackers.length === 0 },
        replay: { val: replay.length ? `${replay.length} found` : 'none', ok: replay.length === 0 },
        cookies: { val: String(cookies), ok: cookies === 0 },
        gpc: { val: gpc ? 'sent · honored' : 'not sent by browser', ok: true, info: !gpc },
        requests: { val: `${entries.length + 1} first-party`, ok: hosts.size === 0, info: true },
        findings: (hosts.size ? 1 : 0) + trackers.length + replay.length,
      };
    };

    const run = () => {
      const r = measure() as Record<string, { val: string; ok: boolean; info?: boolean }> & { findings: number };
      if (r.requests && r.thirdParty.val !== '0') r.requests.val = `${(performance.getEntriesByType('resource').length + 1)} total`;
      const now = new Date();
      time.textContent = now.toISOString().slice(11, 19) + ' UTC';
      result.textContent = 'Scanning…';
      rows.forEach((row) => row.classList.remove('done'));
      bar.style.transition = 'none';
      bar.style.transform = 'scaleX(0)';
      void bar.offsetWidth;
      const step = reduce ? 0 : 320;
      bar.style.transition = `transform ${step * rows.length}ms linear`;
      bar.style.transform = 'scaleX(1)';
      rows.forEach((row, i) => {
        window.setTimeout(() => {
          const c = r[row.dataset.check!];
          row.querySelector('.val')!.textContent = c.val;
          const mark = row.querySelector<HTMLElement>('.mark')!;
          mark.textContent = c.info ? '·' : c.ok ? '✓' : '!';
          mark.dataset.state = c.info ? 'info' : c.ok ? 'ok' : 'bad';
          row.classList.add('done');
        }, step * (i + 1));
      });
      window.setTimeout(() => {
        result.textContent = r.findings === 0 ? '0 findings · no statute triggered' : `${r.findings} signals to review`;
      }, step * (rows.length + 1));
    };

    const start = () => window.setTimeout(run, reduce ? 0 : 900);
    if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true });
    root.querySelector('[data-scan-again]')!.addEventListener('click', run);

    const form = root.querySelector<HTMLFormElement>('form')!;
    form.addEventListener('submit', (e) => {
      const input = form.querySelector<HTMLInputElement>('input')!;
      const v = input.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
      if (!v) { e.preventDefault(); input.focus(); return; }
      input.value = v;
    });
  }
</script>

<style>
  .scan { width: 100%; max-width: 560px; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8); }
  .who { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .host { color: var(--ui-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pulse { animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
  .progress { height: 2px; background: var(--ui-line); }
  .progress i { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .rows .ui-row { grid-template-columns: 1fr auto 20px; }
  .rows .ui-label { font-size: 13.5px; font-weight: 500; color: var(--ui-text); letter-spacing: 0; }
  .val { color: var(--ui-muted); transition: color 0.3s; text-align: right; }
  .done .val { color: var(--ui-text); }
  .mark { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; transform: scale(0.4); opacity: 0; transition: transform 0.4s var(--ease-out), opacity 0.3s; }
  .done .mark { transform: none; opacity: 1; }
  .mark[data-state='ok'] { background: rgba(79, 209, 165, 0.14); color: var(--low); }
  .mark[data-state='bad'] { background: rgba(255, 107, 90, 0.16); color: var(--high); }
  .mark[data-state='info'] { background: var(--ui-bg-2); color: var(--ui-muted); }
  .result {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 16px; border-top: 1px solid var(--ui-line); background: var(--ui-bg-2);
  }
  .domain { display: grid; gap: 8px; padding: 16px; border-top: 1px solid var(--ui-line); }
  .field { display: flex; gap: 8px; }
  .field input { flex: 1; min-width: 0; }
  .field .ui-btn { height: 38px; }
  @media (max-width: 480px) {
    .field { flex-direction: column; }
    .field .ui-btn { justify-content: center; }
  }
</style>
