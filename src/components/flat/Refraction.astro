---
// Flat (/v5) · the risk picture as a refraction. Twenty signals stand in one column, like scattered light; each
// sends a fine curved thread into the Privaini lens, where they meet in a single point; out of the lens come four
// ordered bands, the briefing: findings, exposure, evidence, remediation. What the lens brings to bear turns
// slowly round it as a ring of words. Under it all, a rule and the decisions the briefing supports.
// Noise in, a spectrum out: the drawing's shape is the product's claim. Every label is the live page's.
// Wide (1100px and up): one SVG, drawn as the section scrolls into place (src/scripts/flat-v5.ts), after which
// light keeps travelling down the threads. Narrower: the same content stacked plainly.
// The lens is the only round thing.

const signals: [string, boolean?][] = [
  ['Cookies'], ['Meta pixels'], ['GLBA'], ['CIPA'], ['VPPA', true], ['Policy Gaps'], ['LGPD'], ['Digital Properties'], ['CPRA'], ['GDPR'],
  ['CCPA'], ['CTDPA'], ['Device Fingerprints'], ['PIPEDA'], ['HIPAA'], ['BIPA', true], ['Dark Patterns'], ['Wiretap'], ['EU AI Act'], ['Wrongful Collection'],
];
const caps = ['Regulatory Repository', 'Technology Detection', 'Market Observations', 'AI Transparency', 'Jurisdiction Mapping', 'Evidence Collection', 'Litigation Patterns'];
const decisions = ['Fix what matters first', 'Quantify exposure', 'Brief the board', 'Price or transfer risk', 'Deal Diligence'];

const W = 1320, H = 676;
const L = { x: 590, y: 330, r: 88, ring: 150 };
const sy = (i: number) => 64 + i * 28;
const threads = signals.map(([, hot], i) => ({
  hot,
  d: `M198 ${sy(i)}C${370} ${sy(i)} ${410} ${L.y} ${L.x - L.r} ${(L.y + (i - 9.5) * 1.3).toFixed(1)}`,
  t: (2.6 + ((i * 7) % 6) * 0.3).toFixed(1),
  delay: (((i * 11) % 13) * 0.37).toFixed(2),
}));
// the four bands the lens gives back
const X0 = L.x + L.r, X1 = 904;
const bandY = [120, 252, 384, 516];
const bands = bandY.map((y) => ({
  y,
  ribbon: `M${X0} ${L.y}C790 ${L.y} 800 ${y - 13} ${X1} ${y - 13}V${y + 13}C800 ${y + 13} 790 ${L.y} ${X0} ${L.y}Z`,
  line: `M${X0} ${L.y}C790 ${L.y} 800 ${y} ${X1} ${y}`,
}));
const TX = 926;
// the ring of words: one circle of text round the lens
const ring = `M${L.x - L.ring} ${L.y}a${L.ring} ${L.ring} 0 1 1 ${L.ring * 2} 0a${L.ring} ${L.ring} 0 1 1 ${-L.ring * 2} 0`;
const ringText = caps.join('   ·   ') + '   ·   ';
// the decisions, in a row along the foot
let dx = 250;
const decs = decisions.map((d) => { const x = dx; dx += d.length * 8.4 + 62; return { d, x }; });
---
<figure class="rf" data-rf role="img" aria-label="From your company's website, twenty signals (cookies, pixels, policies and the statutes they meet, among them VPPA and BIPA) run into the Privaini lens, which brings a regulatory repository, technology detection, market observations, AI transparency, jurisdiction mapping, evidence collection and litigation patterns to bear. Out comes the Privaini risk briefing in four parts: findings, exposure, evidence and remediation. From it, your next decisions: fix what matters first, quantify exposure, brief the board, price or transfer risk, deal diligence.">
  <svg class="rf-svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <defs>
      <path id="rf-ring" d={ring} />
      <clipPath id="rf-clip"><rect data-rf-clip x={X0} y="80" width={X1 - X0 + 2} height="480" /></clipPath>
    </defs>

    <!-- what your company gives off -->
    <g class="rf-label"><rect x="80" y="14" width="8" height="8" /><text x="198" y="23" text-anchor="end">Your Company</text></g>
    {signals.map(([s, hot], i) => <text class:list={['rf-sig', { hot }]} x="184" y={sy(i) + 5} text-anchor="end" data-rf-sig>{s}</text>)}
    {threads.map((t) => <path class:list={['rf-thread', { hot: t.hot }]} d={t.d} pathLength="1" data-rf-thread />)}
    {threads.map((t) => <path class:list={['rf-pulse', { hot: t.hot }]} d={t.d} pathLength="1" style={`--t: ${t.t}s; --d: -${t.delay}s`} />)}

    <!-- the briefing: four bands out of the lens -->
    <g clip-path="url(#rf-clip)">
      {bands.map((b) => <path class="rf-ribbon" d={b.ribbon} />)}
      {bands.map((b) => <path class="rf-band" d={b.line} />)}
    </g>

    <!-- the lens, and what it brings to bear, turning round it -->
    <g data-rf-lens>
      <text class="rf-ring" data-rf-ring><textPath href="#rf-ring" textLength={Math.round(2 * Math.PI * L.ring) - 6}>{ringText}</textPath></text>
      <circle class="rf-core" cx={L.x} cy={L.y} r="46" />
      <circle class="rf-inner" cx={L.x} cy={L.y} r="66" />
      <circle class="rf-glass" cx={L.x} cy={L.y} r={L.r} />
      <text class="rf-mark" x={L.x} y={L.y + 2} text-anchor="middle">privaini</text>
      <text class="rf-events" x={L.x} y={L.y + 26} text-anchor="middle"><tspan data-rf-events>14</tspan> events captured</text>
    </g>

    <g class="rf-label" data-rf-out><rect x={TX} y="34" width="8" height="8" /><text x={TX + 20} y="43">Privaini Risk Briefing</text></g>
    <g data-rf-out>
      <text class="rf-t" x={TX} y={bandY[0] - 2}>Findings</text>
      <rect class="rf-tag-fill" x={TX} y={bandY[0] + 12} width="46" height="22" /><text class="rf-tag-in" x={TX + 23} y={bandY[0] + 27.5} text-anchor="middle">High</text>
      <rect class="rf-tag-line" x={TX + 54.5} y={bandY[0] + 12.5} width="50" height="21" /><text class="rf-tag-out" x={TX + 79.5} y={bandY[0] + 27.5} text-anchor="middle">VPPA</text>
      <text class="rf-mono" x={TX + 122} y={bandY[0] + 27.5}>US-CA   US-IL</text>
    </g>
    <g data-rf-out>
      <text class="rf-t" x={TX} y={bandY[1] - 2}>Exposure</text>
      <text class="rf-fig" x={TX} y={bandY[1] + 40}>$<tspan data-rf-exposure>22.5</tspan>M</text>
    </g>
    <g data-rf-out>
      <text class="rf-t" x={TX} y={bandY[2] - 2}>Evidence</text>
      <path class="rf-trace" transform={`translate(${TX} ${bandY[2] + 16})`} d="M0 18H22V12H44V15H66V5H88V8H110V-3H132V1H170" />
    </g>
    <g data-rf-out>
      <text class="rf-t" x={TX} y={bandY[3] - 2}>Remediation</text>
      <rect class="rf-step" x={TX + 0.5} y={bandY[3] + 14.5} width="11" height="11" /><text class="rf-d" x={TX + 22} y={bandY[3] + 25}>Immediate</text>
      <rect class="rf-step on" x={TX + 122} y={bandY[3] + 14} width="12" height="12" /><text class="rf-d" x={TX + 144} y={bandY[3] + 25}>Staged</text>
    </g>

    <!-- and what it lets you decide -->
    <path class="rf-rule" d={`M0 ${H - 62}H${W}`} data-rf-rule />
    <g class="rf-label"><rect x="0" y={H - 32} width="8" height="8" /><text x="20" y={H - 23}>Your Next Decisions</text></g>
    {decs.map((d) => (
      <g class="rf-dec" data-rf-dec>
        <rect class="rf-box" x={d.x} y={H - 35} width="14" height="14" />
        <path class="rf-tick" d={`M${d.x + 3} ${H - 27.5}l3 3 5-6.5`} />
        <text x={d.x + 24} y={H - 23}>{d.d}</text>
      </g>
    ))}
  </svg>

  <!-- narrower: the same, stacked -->
  <div class="rf-m" aria-hidden="true">
    <p class="fx-chip">Your Company</p>
    <ul class="rf-m-sigs" role="list">{signals.map(([s, hot]) => <li class:list={{ hot }}>{s}</li>)}</ul>
    <div class="rf-m-lens"><span class="rf-m-mark">privaini</span><span class="rf-m-ev">14 events captured</span></div>
    <ul class="rf-m-caps" role="list">{caps.map((c) => <li>{c}</li>)}</ul>
    <p class="fx-chip">Privaini Risk Briefing</p>
    <dl class="rf-m-out">
      <div><dt>Findings</dt><dd><b>High</b> VPPA <span>US-CA US-IL</span></dd></div>
      <div><dt>Exposure</dt><dd class="fig">$22.5M</dd></div>
      <div><dt>Evidence</dt><dd><svg viewBox="0 -4 170 24"><path d="M0 18H22V12H44V15H66V5H88V8H110V-3H132V1H170" /></svg></dd></div>
      <div><dt>Remediation</dt><dd>Immediate <span>·</span> Staged</dd></div>
    </dl>
    <p class="fx-chip">Your Next Decisions</p>
    <ul class="rf-m-decs" role="list">{decisions.map((d) => <li>{d}</li>)}</ul>
  </div>
</figure>

<style>
  .rf { margin: 0; color: var(--on-night); }
  .rf-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .rf-svg path, .rf-svg circle { fill: none; }
  .rf-svg text { font-family: var(--font); fill: var(--on-night); }

  .rf-label rect { fill: var(--cyan); }
  .rf-label text { font: 500 12.5px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .rf-sig { font-size: 15px; fill: var(--on-night-muted) !important; }
  .rf-sig.hot { fill: var(--cyan) !important; }
  .rf-thread { stroke: var(--on-night-line-2); stroke-width: 1; stroke-dasharray: 1 1; }
  .rf-thread.hot { stroke: var(--cyan); }
  /* light travelling down a thread: one short dash, once the drawing has played */
  .rf-pulse { stroke: var(--on-night); stroke-width: 1.6; stroke-dasharray: 0.05 2; stroke-dashoffset: 0.2; opacity: 0; }
  .rf-pulse.hot { stroke: var(--cyan); }

  .rf-glass { stroke: var(--cyan); stroke-width: 1.5; }
  .rf-inner { stroke: var(--on-night-line-2); stroke-dasharray: 2 5; }
  .rf-core { fill: var(--cyan-wash) !important; }
  .rf-mark { font: 400 17px/1 var(--logo) !important; }
  .rf-events { font: 500 9.5px/1 var(--mono) !important; letter-spacing: 0.08em; text-transform: uppercase; fill: var(--on-night-muted) !important; }
  .rf-ring { font-size: 12.5px; letter-spacing: 0.02em; fill: var(--on-night-muted) !important; paint-order: stroke; stroke: var(--night); stroke-width: 7px; transform-box: view-box; transform-origin: 590px 330px; }

  .rf-ribbon { fill: var(--cyan-wash) !important; }
  .rf-band { stroke: var(--cyan); stroke-width: 1.5; }
  .rf-t { font-size: 26px; font-weight: 500; letter-spacing: -0.03em; }
  .rf-d { font-size: 15px; }
  .rf-mono { font: 400 13px/1 var(--mono) !important; fill: var(--on-night-muted) !important; white-space: pre; }
  .rf-tag-fill { fill: var(--on-night); }
  .rf-tag-in { font-size: 13px; font-weight: 700; fill: var(--night) !important; }
  .rf-tag-line { fill: none; stroke: var(--on-night-muted); }
  .rf-tag-out { font-size: 13px; font-weight: 700; }
  .rf-fig { font-size: 40px; font-weight: 300; letter-spacing: -0.04em; fill: var(--cyan) !important; font-variant-numeric: tabular-nums; }
  .rf-trace { stroke: var(--cyan); stroke-width: 1.5; }
  .rf-step { fill: none; stroke: var(--on-night-muted); }
  .rf-step.on { fill: var(--cyan); stroke: none; }

  .rf-rule { stroke: var(--on-night-line-2); transform-box: fill-box; transform-origin: left; }
  .rf-dec text { font-size: 15px; }
  .rf-box { fill: var(--cyan); }
  .rf-tick { stroke: var(--night); stroke-width: 1.8; stroke-linecap: square; }

  @media (prefers-reduced-motion: no-preference) {
    .rf-ring { animation: rf-turn 90s linear infinite; }
    .rf.is-live .rf-pulse { opacity: 1; animation: rf-run var(--t) linear var(--d) infinite; }
    .rf:not(.is-vis) :is(.rf-ring, .rf-pulse) { animation-play-state: paused; }
  }
  @keyframes rf-turn { to { transform: rotate(360deg); } }
  @keyframes rf-run { from { stroke-dashoffset: 0.2; } to { stroke-dashoffset: -1; } }

  /* narrower: stacked */
  .rf-m { display: none; }
  @media (max-width: 1099px) {
    .rf-svg { display: none; }
    .rf-m { display: grid; gap: 28px; justify-items: start; }
    .rf-m ul, .rf-m dl, .rf-m p { margin: 0; padding: 0; list-style: none; }
    .rf-m p.fx-chip { padding: 8px 14px 8px 10px; }
    .rf-m-sigs { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 16px; color: var(--on-night-muted); }
    .rf-m-sigs .hot { color: var(--cyan); }
    .rf-m-lens { justify-self: center; display: grid; place-content: center; gap: 8px; width: 200px; aspect-ratio: 1; border: 1.5px solid var(--cyan); border-radius: 50%; text-align: center; }
    .rf-m-mark { font: 400 18px/1 var(--logo); }    .rf-m-ev { font: 500 10px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-night-muted); }
    .rf-m-caps { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 15px; }
    .rf-m-out { display: grid; gap: 20px; width: 100%; }
    .rf-m-out div { display: grid; gap: 8px; padding-left: 16px; border-left: 2px solid var(--cyan); }
    .rf-m-out dt { font: 500 24px/1.1 var(--font); letter-spacing: -0.03em; }
    .rf-m-out dd { margin: 0; font-size: 16px; }
    .rf-m-out dd b { padding: 2px 8px; background: var(--on-night); color: var(--night); }
    .rf-m-out dd span { color: var(--on-night-muted); }
    .rf-m-out .fig { font: 300 36px/1 var(--font); color: var(--cyan); }
    .rf-m-out svg { width: 170px; height: 24px; overflow: visible; }
    .rf-m-out path { fill: none; stroke: var(--cyan); stroke-width: 1.5; }
    .rf-m-decs { display: grid; gap: 12px; font-size: 16px; }
    .rf-m-decs li { display: flex; align-items: center; gap: 12px; }
    .rf-m-decs li::before { content: ''; width: 12px; height: 12px; background: var(--cyan); }
  }
</style>
