---
// What policyholders unlock: the figure on the left (a hairline figure or the sample report),
// the capabilities as a plain list on the right, and the partner's own fine print under it.
import HairlineFigure from '@/components/hairline/HairlineFigure.astro';
import RiskReport from '@/components/RiskReport.astro';
import type { Item } from '@/data/partners-pages';
interface Props {
  id: string;
  heading: string;
  items: Item[];
  figure: 'report' | 'briefing' | 'outside-in-scanner' | 'exposure-scale';
  note?: string;
  fine?: string;
  tone?: 'plain' | 'raised';
}
const { id, heading, items, figure, note, fine, tone = 'plain' } = Astro.props;
const titles = {
  'outside-in-scanner': 'Figure: an outside-in assessment reading a company’s public properties',
  'exposure-scale': 'Figure: the exposure range of each finding in the sample report',
} as const;
---
<section class:list={['caps section', { 'section--raised': tone === 'raised' }]} aria-labelledby={id}>
  <div class="wrap grid">
    <div class="copy" data-reveal-group>
      <h2 id={id} data-split>{heading}</h2>
      <ul role="list" class="items">
        {items.map((item) => (
          <li data-reveal>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      {note && <p class="note" data-reveal>{note}</p>}
      {fine && <p class="fine" data-reveal>{fine}</p>}
    </div>
    <div class="fig" data-reveal>
      {figure === 'report' || figure === 'briefing' ? (
        <div class="stage">
          <RiskReport variant={figure} />
          <p class="caption">Privaini’s published sample {figure === 'briefing' ? 'risk briefing' : 'risk report'} for your-company.com.</p>
        </div>
      ) : (
        <HairlineFigure name={figure} title={titles[figure]} />
      )}
    </div>
  </div>
</section>

<style>
  .grid { align-items: center; row-gap: 48px; }
  .fig { grid-column: 1 / span 6; grid-row: 1; }
  .copy { grid-column: 8 / span 5; grid-row: 1; display: grid; gap: 28px; justify-items: start; }
  h2 { font-size: clamp(30px, 2.8vw, 46px); max-width: 20ch; }
  .items { display: grid; gap: 26px; margin-top: 8px; }
  .items li { display: grid; gap: 6px; }
  h3 { font-size: clamp(19px, 1.4vw, 22px); }
  .items p { color: var(--muted); font-size: 17px; line-height: 1.55; max-width: 44ch; }
  .note { font-size: 17px; color: var(--ink); max-width: 44ch; }
  .fine { font-size: 14.5px; line-height: 1.5; color: var(--muted); max-width: 52ch; }
  .stage {
    background: var(--bg-2); border-radius: var(--radius); padding: clamp(24px, 4vw, 56px);
    display: grid; justify-items: center; gap: 18px;
  }
  .section--raised .stage { background: var(--bg-3); }
  .caption { font-size: 14.5px; color: var(--muted); text-align: center; max-width: 44ch; }
  @media (max-width: 960px) {
    .copy, .fig { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 480px) {
    .stage { padding: 16px; margin-inline: calc(var(--margin) * -1); border-radius: 0; }
  }
</style>
