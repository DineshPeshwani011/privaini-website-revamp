---
// Partners who have built on Privaini, as a large index: the partner's name, what they built, and a
// way through to their page. A closing line (slot) sums up the roster.
interface Link { label: string; href: string }
interface Entry { name: string; text: string; links: Link[] }
interface Props { id: string; heading: string; items: Entry[]; tone?: 'plain' | 'raised' }
const { id, heading, items, tone = 'raised' } = Astro.props;
---
<section class:list={['roster section', { 'section--raised': tone === 'raised' }]} aria-labelledby={id}>
  <div class="wrap">
    <h2 id={id} class="h" data-split>{heading}</h2>
    <ul role="list" class="list" data-reveal-group>
      {items.map((e) => (
        <li data-reveal>
          {e.links.length === 1 ? (
            <a class="row" href={e.links[0].href}>
              <span class="name">{e.name}</span>
              <span class="text">{e.text}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          ) : (
            <div class="row row--multi">
              <span class="name">{e.name}</span>
              <span class="text">{e.text}</span>
              <span class="links">
                {e.links.map((l) => <a class="link" href={l.href}>{l.label} <span class="arrow">→</span></a>)}
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>
    {Astro.slots.has('default') && <div class="closing" data-reveal><slot /></div>}
  </div>
</section>

<style>
  .h { font-size: clamp(30px, 3.2vw, 52px); max-width: 26ch; margin-bottom: clamp(40px, 5vw, 72px); }
  .list { display: grid; }
  .row {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) minmax(0, 1fr); gap: var(--gap);
    align-items: baseline; padding: clamp(20px, 2.2vw, 32px) 0; position: relative; isolation: isolate;
  }
  a.row::before {
    content: ''; position: absolute; inset: 0 calc(var(--margin) * -0.5); background: var(--bg-3); border-radius: var(--radius);
    transform: scaleY(0.6); opacity: 0; transition: transform 0.45s var(--ease-out), opacity 0.3s; z-index: -1;
  }
  a.row:hover::before, a.row:focus-visible::before { transform: none; opacity: 1; }
  .name { font-size: clamp(32px, 4.2vw, 68px); font-weight: 600; letter-spacing: -0.045em; line-height: 0.98; transition: color 0.3s, transform 0.5s var(--ease-out); }
  a.row:hover .name { color: var(--accent-hi); transform: translateX(8px); }
  .text { font-size: 18px; line-height: 1.45; color: var(--ink); max-width: 46ch; }
  .go { font-size: 28px; color: var(--muted); justify-self: end; transition: transform 0.4s var(--ease-out), color 0.3s; }
  a.row:hover .go { transform: translateX(6px); color: var(--accent-hi); }
  .links { display: grid; gap: 6px; justify-items: end; font-size: 16px; }
  .closing { margin-top: clamp(48px, 6vw, 96px); max-width: 30ch; font-size: clamp(22px, 2.6vw, 40px); line-height: 1.18; letter-spacing: -0.025em; font-weight: 500; color: var(--muted); text-wrap: balance; }
  .closing :global(b) { color: var(--ink); font-weight: 600; }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr auto; row-gap: 10px; }
    .name { grid-column: 1; }
    .go, .links { grid-column: 2; grid-row: 1; }
    .text { grid-column: 1 / -1; font-size: 16px; color: var(--muted); }
    .links { grid-auto-flow: column; gap: 16px; }
  }
</style>
