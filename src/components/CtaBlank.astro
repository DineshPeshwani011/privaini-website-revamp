---
// The closing sentence has a blank in it, and the blank is the form: your domain goes to the demo request.
// The heading is inline so the field and the submit word continue its last line on wide screens.
// A hairline lens turns slowly behind it, on the right.
import HairlineField from './hairline/HairlineField.astro';
interface Props { lead?: string; after?: string; note?: string }
const {
  lead = 'See what regulators see on',
  after = 'No sales pitch. No questionnaires. No IT lift. Just your domain name.',
  note = 'No generic alerts · No installation · Domain name only · Statute-mapped findings',
} = Astro.props;
---
<section class="cta section theme-dark has-field" data-nav-dark aria-labelledby="cta-h">
  <HairlineField at={{ x: 0.88, y: 0.5 }} signals={[]} />
  <div class="wrap" data-reveal-group>
    <form class="sentence" action="/request-a-demo" method="get" data-reveal>
      <h2 id="cta-h" class="line">{lead}</h2>
      <label class="sr-only" for="cta-domain">Your company domain</label>
      <input id="cta-domain" name="domain" type="text" inputmode="url" autocomplete="url" placeholder="your domain" spellcheck="false" />
      <button type="submit">first&nbsp;→</button>
    </form>
    <p class="after" data-reveal>{after}</p>
    <p class="note" data-reveal>{note}</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('.cta .sentence').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const input = form.querySelector<HTMLInputElement>('input')!;
      const v = input.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
      if (!v) { e.preventDefault(); input.focus(); return; }
      input.value = v;
    });
  });
</script>

<style>
  .cta { background: var(--field); color: var(--field-ink); padding-block: clamp(96px, 12vw, 200px); }
  .sentence {
    font-size: clamp(34px, 4.3vw, 70px); font-weight: 600; line-height: 1.16; letter-spacing: -0.04em;
    max-width: 22em;
  }
  .line { display: inline; font: inherit; letter-spacing: inherit; margin-right: 0.18em; }
  input, button {
    display: inline-block; vertical-align: baseline; height: 1.08em; padding: 0 0.22em; margin: 0.04em 0;
    font: inherit; letter-spacing: inherit; border: 0; border-radius: var(--radius); line-height: 1;
  }
  input { width: 7.2em; background: rgba(5, 8, 9, 0.35); color: #fff; outline: none; transition: background-color 0.25s; }
  input::placeholder { color: rgba(230, 251, 255, 0.5); }
  input:focus { background: rgba(5, 8, 9, 0.55); box-shadow: 0 0 0 3px var(--accent-hi); }
  button { margin-left: 0.18em; background: var(--accent); color: var(--accent-ink); cursor: pointer; transition: background-color 0.25s, transform 0.25s var(--ease-out); }
  button:hover { background: var(--accent-hi); }
  button:active { transform: translateY(2px); }
  .after { margin-top: 36px; font-size: 19px; max-width: 46ch; }
  .note { margin-top: 10px; font-size: 15px; color: rgba(230, 251, 255, 0.72); }
  @media (max-width: 640px) {
    .sentence { font-size: 8.4vw; }
    input { display: block; width: 100%; height: 1.5em; margin: 0.35em 0 0.25em; font-size: 0.7em; }
    button { margin-left: 0; height: 1.25em; }
    .after { font-size: 17px; }
  }
</style>
