---
// Interior page hero: headline, sentence and actions on the left; the page's product fragment (slot) on
// the right, sitting in the lens, drawn in hairlines, with the page's own signals arriving from behind the copy.
import { DEMO_URL } from '@/data/site';
import HairlineField from './hairline/HairlineField.astro';
interface Props {
  title: string;
  lead?: string;
  primary?: { label: string; href: string } | false;
  secondary?: { label: string; href: string } | false;
  crumb?: { label: string; href: string };
  compact?: boolean;
}
const {
  title,
  lead,
  primary = { label: 'See your exposure', href: DEMO_URL },
  secondary = { label: 'See a sample report', href: DEMO_URL },
  crumb,
  compact = false,
} = Astro.props;
const hasFragment = Astro.slots.has('default');
---
<section class:list={['hero', { 'hero--split': hasFragment, 'hero--compact': compact }]}>
  <HairlineField at={hasFragment ? { x: 0.74, y: 0.55 } : { x: 0.82, y: 0.5 }} />
  <div class="wrap inner">
    <div class="copy" data-reveal-group>
      {crumb && <a class="crumb" href={crumb.href} data-reveal>← {crumb.label}</a>}
      <h1 data-split data-split-now set:html={title} />
      {lead && <p class="t-lead lead" data-reveal>{lead}</p>}
      {(primary || secondary) && (
        <div class="actions" data-reveal>
          {primary && <a class="btn" href={primary.href}>{primary.label} <span class="arrow">→</span></a>}
          {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
        </div>
      )}
    </div>
    {hasFragment && (
      <div class="fragment" data-reveal>
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative; padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 112px)); padding-bottom: clamp(64px, 8vw, 128px); overflow: clip;
    background: radial-gradient(70% 90% at 75% 55%, var(--hero-glow), var(--bg-clear) 70%), var(--bg);
  }
  .hero--compact { padding-bottom: clamp(40px, 5vw, 72px); }
  .hero::after { content: ''; position: absolute; inset: auto 0 0; height: 120px; background: linear-gradient(to bottom, var(--bg-clear), var(--bg)); pointer-events: none; }
  .inner { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 48px; align-items: center; }
  .copy { grid-column: 1 / span 10; display: grid; gap: 28px; justify-items: start; }
  .hero--split .copy { grid-column: 1 / span 6; padding-right: clamp(0px, 2vw, 32px); }
  .hero--split h1 { font-size: clamp(38px, 4.4vw, 64px); }
  .crumb { font-size: 15px; color: var(--muted); transition: color 0.2s; }
  .crumb:hover { color: var(--accent-hi); }
  .lead { color: var(--muted); }
  .fragment { grid-column: 7 / span 6; display: grid; justify-items: center; padding-left: clamp(0px, 3vw, 48px); }
  @media (max-width: 960px) {
    .copy, .hero--split .copy { grid-column: 1 / -1; padding-right: 0; }
    .fragment { grid-column: 1 / -1; padding: 32px 0 0; justify-items: stretch; }
    .fragment > :global([data-ui]) { max-width: none; }
    .hero--split h1 { font-size: clamp(31px, 8vw, 64px); }
  }
</style>
