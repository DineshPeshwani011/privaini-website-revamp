---
import Wordmark from './Wordmark.astro';
import { solutions, partners, platform, statutes, legal, contact, PLATFORM_URL } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div class="col col--intro">
        <p class="pitch">Privacy &amp; AI risk intelligence, observed from the outside.</p>
        <address>
          {contact.address.map((line) => <span>{line}</span>)}
        </address>
        <p class="mail">
          <a href={`mailto:${contact.sales}`}>Sales · {contact.sales}</a>
          <a href={`mailto:${contact.support}`}>Support · {contact.support}</a>
        </p>
      </div>
      <nav class="col" aria-label="Platform">
        <p class="col-title">Platform</p>
        <ul role="list">
          {platform.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={PLATFORM_URL}>Log in</a></li>
        </ul>
      </nav>
      <nav class="col" aria-label="Solutions">
        <p class="col-title">Solutions</p>
        <ul role="list">{solutions.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="col" aria-label="Statutes">
        <p class="col-title">Statutes</p>
        <ul role="list">{statutes.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="col" aria-label="Partners">
        <p class="col-title">Partners</p>
        <ul role="list">
          {partners.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/partner-program">Partner program</a></li>
        </ul>
      </nav>
      <nav class="col" aria-label="Company">
        <p class="col-title">Company</p>
        <ul role="list">
          <li><a href="/about-us">About us</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/case-studies">Case studies</a></li>
          <li><a href="/request-a-demo">Request a demo</a></li>
        </ul>
      </nav>
    </div>

    <a href="/" class="giant" aria-label="Privaini home" data-footer-mark><Wordmark size="xl" /></a>

    <div class="base">
      <p>© {year} Privaini Inc. All rights reserved.</p>
      <ul role="list" class="legal">
        {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <p class="gpc" data-gpc><span class="gpc-dot" aria-hidden="true"></span><span data-gpc-text>No trackers on this site</span></p>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector('[data-gpc-text]');
  if (el && (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl) {
    el.textContent = 'Opt-out signal honored';
  }
</script>

<style>
  .footer { background: var(--bg); padding-top: clamp(96px, 12vw, 180px); overflow: clip; }
  .cols {
    display: grid; grid-template-columns: 1.6fr repeat(5, 1fr); gap: 40px var(--gap);
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .pitch { font-size: clamp(22px, 1.9vw, 28px); line-height: 1.2; letter-spacing: -0.02em; font-weight: 600; max-width: 18ch; margin-bottom: 28px; }
  address { font-style: normal; display: grid; color: var(--muted); font-size: var(--t-small); margin-bottom: 18px; }
  .mail { display: grid; gap: 4px; font-size: var(--t-small); }
  .mail a { color: var(--ink); width: fit-content; }
  .mail a:hover { color: var(--accent-hi); }
  .col-title { font-size: var(--t-small); color: var(--muted); margin-bottom: 14px; }
  .col ul { display: grid; gap: 9px; }
  .col a { font-size: var(--t-small); color: var(--ink); transition: color 0.2s; }
  .col a:hover { color: var(--accent-hi); }
  /* the wordmark fills the column exactly: its ink starts on the address's left edge and ends on Company's right.
     Sized from the column's width (cqi), not the viewport's. Bruno Ace SC "PRIVAINI" at 0.01em tracking measures
     5.289em of ink, starting 0.08em in from its origin, so 100cqi / 5.289 = 18.907cqi, and -0.08em pulls the ink
     onto the edge. */
  .giant { display: block; container-type: inline-size; padding-bottom: clamp(20px, 2.4vw, 36px); line-height: 0.8; }
  .giant :global(.wordmark) { font-size: 18.907cqi; letter-spacing: 0.01em; margin-left: -0.08em; transition: color 0.4s; }
  .base {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding-block: 22px 28px; font-size: 14px; color: var(--muted);
  }
  .legal { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: center; }
  .legal a { color: var(--ink); }
  .legal a:hover { color: var(--accent-hi); }
  .gpc { justify-self: end; display: inline-flex; align-items: center; gap: 8px; }
  .gpc-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--low); }
  @media (max-width: 1080px) {
    .cols { grid-template-columns: repeat(3, 1fr); }
    .col--intro { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .cols { grid-template-columns: repeat(2, 1fr); }
    .base { grid-template-columns: 1fr; justify-items: start; }
    .legal { justify-content: start; }
    .gpc { justify-self: start; }
  }
</style>
