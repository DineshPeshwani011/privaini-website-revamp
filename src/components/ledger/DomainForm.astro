---
// Ledger · domain field: the product's one input, so the page's main action. A mono field joined to the primary
// button; the domain goes to the demo request (same field name as CtaBlank). `night` is for the dark band.
interface Props { id: string; tone?: 'paper' | 'night'; cta?: string; note?: string }
const { id, tone = 'paper', cta = 'See your exposure', note } = Astro.props;
---
<form class:list={['domain', `domain--${tone}`]} action="/request-a-demo" method="get">
  <div class="field">
    <label class="sr-only" for={id}>Your company domain</label>
    <span class="scheme" aria-hidden="true">https://</span>
    <input id={id} name="domain" type="text" inputmode="url" autocomplete="url" placeholder="yourcompany.com" spellcheck="false" />
    <button class="btn" type="submit">{cta} <span class="arrow">→</span></button>
  </div>
  {note && <p class="note l-label">{note}</p>}
</form>

<script>
  // a bare domain only: drop a pasted scheme or path; an empty field just takes focus
  document.querySelectorAll<HTMLFormElement>('form.domain').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const input = form.querySelector<HTMLInputElement>('input')!;
      const v = input.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
      if (!v) { e.preventDefault(); input.focus(); return; }
      input.value = v;
    });
  });
</script>

<style>
  .domain { display: grid; gap: 14px; width: 100%; max-width: 560px; }
  .field {
    display: flex; align-items: stretch; height: 56px;
    border: 1px solid var(--line-2); border-radius: 4px; background: var(--bg);
    transition: border-color 0.2s var(--ease-std);
  }
  .field:focus-within { border-color: var(--ink); }
  .scheme { display: flex; align-items: center; padding-left: 16px; font: 400 14px/1 var(--mono); color: var(--faint); }
  input {
    flex: 1; min-width: 0; padding: 0 12px 0 2px; border: 0; background: transparent; outline: none;
    font: 400 15px/1 var(--mono); color: var(--ink);
  }
  input::placeholder { color: var(--faint); }
  .btn { min-height: 0; margin: 5px; border-radius: 3px; flex: none; }
  .note { color: var(--faint); }

  .domain--night .field { background: transparent; border-color: var(--night-line); }
  .domain--night .field:focus-within { border-color: var(--night-ink); }
  .domain--night input { color: var(--night-ink); }
  .domain--night .scheme, .domain--night input::placeholder { color: #6f6f6b; }
  .domain--night .btn { --btn-bg: var(--night-ink); --btn-ink: var(--night); }
  .domain--night .btn:hover { --btn-bg: #ffffff; }
  .domain--night .note { color: var(--night-muted); }

  @media (max-width: 520px) {
    .field { flex-wrap: wrap; height: auto; }
    .scheme { padding-block: 16px; }
    input { padding-block: 16px; }
    .btn { width: calc(100% - 10px); min-height: 46px; }
  }
</style>
