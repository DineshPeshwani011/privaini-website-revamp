---
// "Built for every team with privacy exposure": audiences as a large index; hovering a name shows what that team sees.
import { solutions } from '@/data/site';
interface Props { heading?: string; items?: { label: string; href: string; note?: string; sees?: string }[] }
const sees: Record<string, string> = {
  '/enterprises': 'Policy vs practice gaps across every property you run',
  '/insurers': 'Applicant posture at submission, portfolio drift after bind',
  '/brokers': 'Evidence that differentiates a client at placement',
  '/law-firms': 'VPPA, BIPA and wiretap claims visible before discovery',
  '/ma-advisors': 'Liability a target emits before it transfers at close',
  '/risk-advisors': 'Statute-mapped findings to bring into every engagement',
};
const { heading = 'Built for every team with privacy exposure.', items = solutions.map((s) => ({ ...s, sees: sees[s.href] })) } = Astro.props;
---
<section class="aud section" aria-labelledby="aud-h">
  <div class="wrap">
    <h2 id="aud-h" class="h" data-split>{heading}</h2>
    <ul role="list" class="list" data-reveal-group>
      {items.map((item) => (
        <li data-reveal>
          <a href={item.href} class="row">
            <span class="name">{item.label}</span>
            <span class="note">{item.note}</span>
            <span class="sees">{item.sees}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .h { font-size: clamp(30px, 3.5vw, 56px); max-width: 20ch; margin-bottom: clamp(40px, 5vw, 72px); }
  .list { display: grid; }
  .row {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr) 40px; gap: var(--gap);
    align-items: baseline; padding: clamp(18px, 2vw, 28px) 0; position: relative;
  }
  .row::before {
    content: ''; position: absolute; inset: 0 calc(var(--margin) * -0.5); background: var(--bg-2); border-radius: var(--radius);
    transform: scaleY(0.6); opacity: 0; transition: transform 0.45s var(--ease-out), opacity 0.3s;
    z-index: -1;
  }
  .row:hover::before, .row:focus-visible::before { transform: none; opacity: 1; }
  .name { font-size: clamp(34px, 4.6vw, 76px); font-weight: 600; letter-spacing: -0.045em; line-height: 0.95; transition: color 0.3s, transform 0.5s var(--ease-out); }
  .row:hover .name { color: var(--accent-hi); transform: translateX(8px); }
  .note { font-size: 18px; color: var(--ink); line-height: 1.4; }
  .sees { font-size: 15px; color: var(--muted); line-height: 1.45; }
  .go { font-size: 28px; color: var(--muted); justify-self: end; transition: transform 0.4s var(--ease-out), color 0.3s; }
  .row:hover .go { transform: translateX(6px); color: var(--accent-hi); }
  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr 32px; row-gap: 8px; }
    .name { grid-column: 1; }
    .go { grid-column: 2; grid-row: 1; }
    .note, .sees { grid-column: 1 / -1; }
    .sees { display: none; }
    .note { font-size: 16px; color: var(--muted); }
  }
</style>
